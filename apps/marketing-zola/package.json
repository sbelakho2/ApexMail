{
  "name": "@apexmail/marketing-zola",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:css && pnpm run build:zola",
    "build:css": "npx tailwindcss -i static/css/input.css -o static/css/styles.css --minify",
    "build:zola": "zola build",
    "dev": "pnpm run build:css && concurrently \"pnpm run dev:css\" \"zola serve --port 1111\"",
    "dev:css": "npx tailwindcss -i static/css/input.css -o static/css/styles.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "concurrently": "^8.2.0"
  }
}
