# ──────────────────────────────────────────────
# Security & caching headers (Netlify / Cloudflare Pages)
# Canonical headers for the marketing-zola static export
# ──────────────────────────────────────────────

/*
  X-DNS-Prefetch-Control: on
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  # "0" — deprecated header, pinned in lockstep with nginx.conf, .htaccess
  # and the api-server (api-server/src/app.rs).
  X-XSS-Protection: "0"
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # CSP — keep in lockstep with the nginx marketing vhost
  # (apps/marketing-zola/nginx.conf) and the edge nginx marketing server
  # (deploy/nginx/nginx.conf): all three must list the same form-action
  # exceptions. `form-action` allows the cross-origin API host because
  # the contact forms (content/contact/*.md × 4 locales) and the pricing
  # calculator POST to https://api.apexmail.ee — without the exception
  # every one of those submissions is dead on Netlify/Cloudflare Pages.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://apexmail.ee; font-src 'self' data:; connect-src 'self' https://api.apexmail.ee https://status.apexmail.ee; frame-src 'none'; form-action 'self' https://api.apexmail.ee; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

# Build asset with a content-hash URL (?h=): immutable, like the /css tree it
# complements (the nginx extension regex and the api-server tier agree).
/giallo.css
  Cache-Control: public, max-age=31536000, immutable

/icon.svg
  Cache-Control: public, max-age=3600

/manifest.json
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/pgp-key.asc
  Cache-Control: public, max-age=3600

/pgp-key.txt
  Cache-Control: public, max-age=3600

/.well-known/*
  Cache-Control: public, max-age=3600

# Downloadable API contract: no-cache, matching the api-server's default tier
# for /specs/ (not an immutable build asset).
/specs/*
  Cache-Control: no-cache

# Error pages (404.html / 50x.html): Netlify and Cloudflare Pages serve
# these automatically for matching error statuses — they must never be
# cached, matching the `internal` no-store locations in
# apps/marketing-zola/nginx.conf.
/404.html
  Cache-Control: no-store

/50x.html
  Cache-Control: no-store
