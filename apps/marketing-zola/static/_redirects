# Redirect rules for the marketing-zola static export
# Compatible with Netlify, Cloudflare Pages, and similar hosting platforms.
# For nginx, convert these to rewrite rules in the server block.
# SECURITY: All external redirect targets use HTTPS (verified 2026-05-06).

# App shortcuts (temporary 302)
/app                 https://app.apexmail.ee            302
/signup              https://app.apexmail.ee/signup     302

# NOTE — /status is NOT redirected. Localized static status pages exist
# at /status/, /de/status/, /fr/status/, /es/status/ (content/status/)
# and the footer links to {{ lp }}/status/ in every locale. The former
# `/status` + `/status/*` → status.apexmail.ee rules stole those URLs on
# Netlify/Cloudflare Pages and sent footer traffic off-site, while the
# nginx vhost (apps/marketing-zola/nginx.conf) served the pages — the
# story now matches on every host: the static page is the localized
# index, and it (plus the footer's live-status link,
# config.extra.status_url) points at status.apexmail.ee for live data.

# Inbox Placement page moved from /docs/ to top-level (2026-05-11)
/docs/inbox-placement  /inbox-placement/  302

# API Explorer renamed from /api-console/ (2026-08-09)
/api-console           /api-explorer/  301
/api-console/*         /api-explorer/:splat  301
