# ──────────────────────────────────────────────
# Apache Configuration for ZoneOS deployment
# Ensures HSTS and security headers on apexmail.ee and www.apexmail.ee
# ──────────────────────────────────────────────

<IfModule mod_headers.c>
    # Strict Transport Security (2-year max-age, include subdomains, preload)
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # Other security headers
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # "0" (audit SM11 F10): the header is deprecated and "1; mode=block" is
    # attack-enabling in legacy auditor implementations — pinned in lockstep
    # with nginx.conf and the api-server.
    Header always set X-XSS-Protection "0"
</IfModule>

# Deny access to sensitive files
<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>
