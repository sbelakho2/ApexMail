# ──────────────────────────────────────────────
# Apache Configuration for ZoneOS deployment
# Ensures HSTS and security headers on apexmail.ee and www.apexmail.ee
#
# SCOPE (review §9): this file is the Apache EQUIVALENT of the canonical
# delivery behavior — it is not an independent route authority. Header values
# mirror apps/marketing-zola/static/_headers (edge) and nginx.conf (container);
# the relocation rules below mirror static/_redirects so /forensic, /api-console
# and /case-studies resolve identically on every deployment mode.
# ──────────────────────────────────────────────

<IfModule mod_headers.c>
    # Strict Transport Security (2-year max-age, include subdomains, preload)
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # Other security headers
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # "0" (audit SM11 F10): the header is deprecated and "1; mode=block" is
    # attack-enabling in legacy auditor implementations — pinned in lockstep
    # with nginx.conf and the api-server.
    Header always set X-XSS-Protection "0"
</IfModule>

# Deny access to sensitive files
<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

# Canonical relocations (equivalent to static/_redirects + nginx.conf).
<IfModule mod_alias.c>
    RedirectMatch 301 ^/api-console/?$ /api-explorer/
    RedirectMatch 301 ^/case-studies/(.*)$ /solutions/$1
    RedirectMatch 301 ^/(de|fr|es)/case-studies/?$ /$1/solutions/
    RedirectMatch 301 ^/forensic/?$ /email-logs/
    RedirectMatch 301 ^/(de|fr|es)/forensic/?$ /$1/email-logs/
</IfModule>
