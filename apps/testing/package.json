{
    "name": "@apexmail/testing",
    "version": "1.0.0",
    "private": true,
    "description": "ApexMail Testing & Quality Gates - E2E, chaos, visual regression, and performance testing",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts",
        "dev": "tsup src/index.ts --format esm --dts --watch",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:visual": "playwright test --project=visual",
        "test:visual:update": "playwright test --project=visual --update-snapshots",
        "test:perf": "tsx src/performance/runner.ts",
        "test:chaos": "tsx src/chaos/runner.ts",
        "test:load": "k6 run src/load/scenarios.js",
        "report": "playwright show-report",
        "lint": "eslint src --ext .ts,.tsx",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@faker-js/faker": "^8.4.1",
        "@playwright/test": "^1.42.0",
        "axe-core": "^4.8.4",
        "axe-playwright": "^2.0.1",
        "c8": "^9.1.0",
        "chalk": "^5.3.0",
        "clinic": "^13.0.0",
        "commander": "^12.0.0",
        "dotenv": "^16.4.1",
        "fast-check": "^3.15.1",
        "lighthouse": "^11.6.0",
        "msw": "^2.2.1",
        "p-limit": "^5.0.0",
        "playwright": "^1.42.0",
        "tsx": "^4.7.1",
        "vitest": "^1.3.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@playwright/browser-chromium": "^1.42.0",
        "@types/node": "^20.11.0",
        "@vitest/coverage-v8": "^1.3.0",
        "@vitest/ui": "^1.3.0",
        "eslint": "^8.56.0",
        "tsup": "^8.0.2",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
