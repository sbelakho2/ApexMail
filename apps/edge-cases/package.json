{
  "name": "@apexmail/edge-cases",
  "version": "1.0.0",
  "description": "ApexMail Edge Cases & Advanced Email Handling",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
