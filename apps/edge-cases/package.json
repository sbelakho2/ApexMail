    "node-clamav": "^1.0.11",
    "nodemailer": "^6.9.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/mime-types": "^2.1.4",
    "@types/nodemailer": "^6.4.14",
    "typescript": "^5.3.3",
