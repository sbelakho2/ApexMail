{
  "schema": "kiwicaptcha.evidence-vectors/1",
  "title": "Shared cross-language evidence vectors: telemetry-v1 scoring, solve anomaly, stage composition and decoy escalation",
  "note": "Both risk cores must resolve every vector identically. The scorer constants below are the single authority mirrored by EvidenceModel.php and evidence.rs; a constant revision is one edit here plus a schema_version bump.",
  "consts": {
    "version": 1,
    "score_saturation": 1000,
    "sample_cap": 32,
    "entropy_max": 15,
    "entropy_min_samples": 32,
    "entropy_weight": 400,
    "focus_weight": 200,
    "paste_weight": 400,
    "paste_volume_floor": 8,
    "paste_ratio_edge": 900,
    "paste_anomaly_value": 800,
    "human_band_edge": 150,
    "agent_evidence_edge": 400,
    "interaction_weight": 500,
    "solve_weight": 500,
    "solve_ratio_saturation_mille": 1000,
    "band_edges": [
      150,
      300,
      500,
      700
    ],
    "band_rungs": [
      "sha16",
      "sha18",
      "sha20",
      "argon16"
    ],
    "max_solve_ms": 3600000
  },
  "interaction_formula": "scale = min(n, 32) * 1000 / 32; entropy_term = (n >= 32) ? (15 - qe) * 1000 / 15 : 0; focus_term = (ec.fm > 0 and ft == 0) ? 1000 : 0; paste_term = (ec.ke + ec.pa >= 8 and ec.pa > 0 and pt >= 900) ? 800 : 0; weighted = entropy_term * 400 + focus_term * 200 + paste_term * 400; interaction_anomaly = min(1000, weighted * scale / 1000000). All divisions are integer divisions.",
  "solve_formula": "ratio_mille = min(solve_ms, 3600000) * 1000 / p1_ms(rung); solve_anomaly = ratio_mille >= 1000 ? 0 : 1000 - ratio_mille; an unknown rung scores 0. All divisions are integer divisions.",
  "p1_ms": {
    "sha16": 23,
    "sha18": 27,
    "sha20": 27,
    "argon16": 86,
    "argon32": 86,
    "argon64": 86,
    "rsw75k": 244,
    "rsw150k": 432,
    "rsw300k": 810
  },
