  "stage": {
    "composition": "The evidence stage runs after the marks stage and before the pricing stage. combined = weighted(interaction, 500) + weighted(solve, 500); a combined score below the first band edge passes the decision through untouched; otherwise the action rises to the band rung (sha16, sha18, sha20, argon16), never beyond the first argon rung, and an argon rung on a saturated backend re-escalates to the interactive step-up.",
    "policy": {
      "version": 3,
      "weights": {
        "source_fast": 190,
        "source_slow": 110,
        "subnet_fast": 80,
        "issue_debt": 150,
        "bad_proof": 220,
        "malformed": 260,
        "replay": 320,
        "action_failure": 120,
        "scope_switch": 60,
        "global_pressure": 170,
        "network_risk": 100,
        "trust_credit": 130,
        "principal_credit": 100
      },
      "scopes": {
        "1": {
          "base_risk": 100,
          "minimum": "allow",
          "post_solve_check": true,
          "degraded": "sha20"
        }
      },
      "global_floors": {
        "0": "allow",
        "1": "sha16",
        "2": "sha18",
        "3": "sha20",
        "4": "sha20"
      }
    },
    "pass_through_rule": "Below the first band edge nothing fired and the decision passes through byte-identically with no reasons. At or above the edge the evidence has fired: the stage reasons prepend, and the action rises to the band rung only when that exceeds the composed action, so a deny is never softened and a stronger rung never lowered.",
    "vectors": [
      {
        "name": "absent-evidence-passes-through",
        "interaction": null,
        "solve_ms": null,
        "rung": null,
        "score": 100,
        "expected_action": "allow",
        "expected_stage_reasons": []
      },
      {
        "name": "human-band-passes-through",
        "interaction": 80,
        "solve_ms": null,
        "rung": null,
        "score": 100,
        "expected_action": "allow",
        "expected_stage_reasons": []
      },
      {
        "name": "agent-evidence-alone-raises",
        "interaction": 400,
        "solve_ms": 100,
        "rung": "sha18",
        "score": 100,
        "expected_action": "sha16",
        "expected_stage_reasons": [
          "interaction_anomaly"
        ]
      },
      {
        "name": "instant-solve-raises",
        "interaction": null,
        "solve_ms": 0,
        "rung": "sha20",
        "score": 100,
        "expected_action": "sha20",
        "expected_stage_reasons": [
          "solve_anomaly"
        ]
      },
      {
        "name": "strong-evidence-caps-at-first-argon",
        "interaction": 640,
        "solve_ms": 0,
        "rung": "sha18",
        "score": 100,
        "expected_action": "argon16",
        "expected_stage_reasons": [
          "interaction_anomaly",
          "solve_anomaly"
        ]
      },
      {
        "name": "evidence-never-lowers-a-deny",
        "interaction": 640,
        "solve_ms": 0,
        "rung": "sha18",
        "score": 980,
        "expected_action": "deny",
        "expected_stage_reasons": [
          "interaction_anomaly",
          "solve_anomaly"
        ]
      }
    ]
  },
