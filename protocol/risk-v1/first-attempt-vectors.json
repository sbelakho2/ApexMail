    {
      "note": "home ASN, home prefix, trusted session: the fully vouched login",
      "asn": "seen", "prefix": "seen", "continuity": "bound", "account_trusted": false,
      "expected": {
        "learn":   { "action": "allow", "novel_network": false, "evidence_unavailable": false, "global_attack": false, "breached_credential": false, "session_trust": "minted", "device_trust": "minted" },
        "enforce": { "action": "allow", "novel_network": false, "evidence_unavailable": false, "global_attack": false, "breached_credential": false, "session_trust": "minted", "device_trust": "minted" }
      }
    },
