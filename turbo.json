{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_TRACKING_URL",
        "NEXT_PUBLIC_APP_URL",
        "BASE_URL",
        "STRIPE_PUBLIC_KEY",
        "SENTRY_DSN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "env": ["CI", "NODE_ENV"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "outputs": [],
      "env": ["CI", "NODE_ENV"]
    },
    "test:unit": {
      "outputs": ["coverage/**"],
      "env": ["CI", "NODE_ENV"]
    },
    "test:integration": {
      "outputs": [],
      "env": ["CI", "NODE_ENV"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "env": ["CI", "NODE_ENV"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
