{
  "name": "apexmail",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade transactional email platform",
  "author": "Bel Consulting OÜ",
  "license": "PROPRIETARY",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "test:coverage:report": "tsx tools/coverage-report.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "tsx tools/migrate/index.ts migrate",
    "db:migrate:dry": "tsx tools/migrate/index.ts migrate --dry-run",
    "db:seed": "tsx tools/migrate/seed.ts",
    "bootstrap": "./tools/bootstrap.sh",
    "verify:routes": "tsx tools/verify-routes.ts",
    "verify:unused": "tsx tools/verify-unused.ts",
    "verify:contracts": "node tools/check-contract-manifest.mjs && node tools/check-contract-backcompat.mjs",
    "verify:contracts:manifest": "node tools/check-contract-manifest.mjs",
    "verify:contracts:backcompat": "node tools/check-contract-backcompat.mjs",
    "verify:contracts:consumer": "node tools/contract-tests/consumer-contract-test.mjs",
    "verify:contracts:producer": "node tools/contract-tests/producer-contract-test.mjs",
    "verify:contracts:tests": "pnpm verify:contracts:consumer && pnpm verify:contracts:producer",
    "verify:billing:boundary": "node tools/check-billing-ts-boundary.mjs",
    "verify:rust:fmt": "cargo fmt --manifest-path services/mail-server/Cargo.toml --all --check",
    "verify:rust:clippy": "cargo clippy --manifest-path services/mail-server/Cargo.toml --workspace --all-targets -- -D warnings",
    "verify:rust:no-unsafe": "node tools/check-rust-unsafe.mjs",
    "verify:rust:quality": "pnpm verify:rust:fmt && pnpm verify:rust:clippy && pnpm verify:rust:no-unsafe",
    "sbom:generate": "cyclonedx-node --output sbom.json",
    "chaos:run": "tsx tools/chaos/runner.ts",
    "reconcile": "tsx tools/reconcile.ts"
  },
  "devDependencies": {
    "@cyclonedx/bom": "^4.1.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "eslint": "^9.15.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "prettier": "^3.2.0",
    "turbo": "^2.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.15.4"
  },
  "packageManager": "pnpm@9.15.4",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not ie 11"
  ]
}
