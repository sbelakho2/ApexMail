# =============================================================================
# ApexMail .dockerignore
# =============================================================================
# Exclude files not needed in Docker build context to reduce build time and image size

# Version control
.git
.gitignore

# Build outputs (rebuilt in container)
**/dist
**/build
**/.turbo
**/target

# Development files
.env
.env.*
!.env.example
.vscode
.idea
*.swp
*.swo
*~

# Documentation (not needed at runtime)
docs/
*.md
LICENSE
!docs/
!docs/api-contract-manifest.json
!docs/development/
!docs/development/*.json
!docs/tool-contracts/
!docs/tool-contracts/stripe.md

# Test files
**/tests
**/__tests__
**/reports

# Development tools

# Docker files (avoid recursive inclusion)
Dockerfile*
!deploy/**/Dockerfile*
!services/**/Dockerfile*
!apps/**/Dockerfile*
docker-compose*

# Misc
.DS_Store
*.log
tmp/
