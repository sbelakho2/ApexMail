# =============================================================================
# ApexMail .dockerignore
# =============================================================================
# Exclude files not needed in Docker build context to reduce build time and image size

# Version control
.git
.gitignore

# Node modules (reinstalled in container)
node_modules
**/node_modules

# Build outputs (rebuilt in container)
**/dist
**/build
**/.next
**/.turbo

# Development files
.env
.env.*
!.env.example
.vscode
.idea
*.swp
*.swo
*~

# Documentation (not needed at runtime)
docs/
*.md
LICENSE

# Test files
**/tests
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
apps/testing
**/__tests__
**/vitest.config.*
**/playwright.config.*
**/reports

# Development tools
tools/chaos
tools/coverage-report.ts

# Docker files (avoid recursive inclusion)
Dockerfile*
docker-compose*

# Misc
.DS_Store
*.log
tmp/
