{% block kiwi_captcha_widget %}
{%- set endpoint = endpoint|default('/kiwi-captcha/challenge') -%}
{%- set scope = scope|default('login') -%}
{%- set nonce = nonce|default('') -%}
{%- set telemetry = telemetry|default('off') -%}
{%- set riskClientContext = risk_client_context|default(false) -%}
{%- set requestBinding = request_binding|default('') -%}
{%- set algorithm = algorithm|default('') -%}
{%- if asset_tags is defined and asset_tags is not empty -%}
{{ asset_tags|raw }}
{%- endif -%}
{%- if asset_mode is not defined or asset_mode == 'inline' -%}
<style{% if nonce %} nonce="{{ nonce }}"{% endif %}>
{{ kiwi_css|raw }}
</style>
{%- endif -%}
<div class="kiwi-container" data-kiwi-endpoint="{{ endpoint }}" data-kiwi-scope="{{ scope }}" data-kiwi-telemetry="{{ telemetry }}"{% if riskClientContext %} data-kiwi-risk-context="coarse"{% endif %}{% if requestBinding %} data-kiwi-request-binding="{{ requestBinding }}"{% endif %}{% if algorithm %} data-kiwi-algorithm="{{ algorithm }}"{% endif %}{% if runtime_src is defined and runtime_src is not empty %} data-kiwi-runtime-src="{{ runtime_src }}"{% if runtime_integrity is defined and runtime_integrity is not empty %} data-kiwi-runtime-integrity="{{ runtime_integrity }}"{% endif %}{% endif %}{% if worker_src is defined and worker_src is not empty %} data-kiwi-worker-src="{{ worker_src }}"{% if worker_integrity is defined and worker_integrity is not empty %} data-kiwi-worker-integrity="{{ worker_integrity }}"{% endif %}{% endif %}{% if execution_src is defined and execution_src is not empty %} data-kiwi-execution-src="{{ execution_src }}"{% if execution_integrity is defined and execution_integrity is not empty %} data-kiwi-execution-integrity="{{ execution_integrity }}"{% endif %}{% endif %}{% if locales_src is defined and locales_src is not empty %} data-kiwi-locales-src="{{ locales_src }}"{% if locales_integrity is defined and locales_integrity is not empty %} data-kiwi-locales-integrity="{{ locales_integrity }}"{% endif %}{% endif %}{% if asset_mode is defined and asset_mode == 'files' %}{% if risk_src is defined and risk_src is not empty %} data-kiwi-risk-src="{{ risk_src }}"{% if risk_integrity is defined and risk_integrity is not empty %} data-kiwi-risk-integrity="{{ risk_integrity }}"{% endif %}{% endif %}{% if telemetry_src is defined and telemetry_src is not empty %} data-kiwi-telemetry-src="{{ telemetry_src }}"{% if telemetry_integrity is defined and telemetry_integrity is not empty %} data-kiwi-telemetry-integrity="{{ telemetry_integrity }}"{% endif %}{% endif %}{% endif %}>
    <input type="hidden" name="{{ full_name }}" value="" data-kiwi-token />
    <div class="kiwi-widget" data-kiwi-widget data-state="idle"
         role="group" aria-label="KiwiCaptcha security check">
        <div class="kiwi-icon-wrapper" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M 5 42 C 12 30, 18 24, 23.9 22.9 A 20 20 0 1 1 18.3 33.5 C 14 35, 9 40, 5 42 Z" fill="currentColor"/>
            </svg>
            <div class="kiwi-glow"></div>
        </div>
        <div class="kiwi-main">
            <div class="kiwi-top">
                <span class="kiwi-label" data-kiwi-label>Security Check</span>
                <span class="kiwi-badge" data-kiwi-badge>Idle</span>
            </div>
            <div class="kiwi-track" aria-hidden="true">
                <div class="kiwi-bar" data-kiwi-bar></div>
            </div>
            <div class="kiwi-bottom">
                <p class="kiwi-info" data-kiwi-info>Protected by KiwiCaptcha</p>
                <span class="kiwi-timer" data-kiwi-timer></span>
            </div>
        </div>
        {# The dedicated live region: the only aria-live
           element on the widget. State changes land here via
           data-kiwi-status (the driver's announcer); the countdown,
           label, badge and hint stay outside the live region so a
           ticking timer can never spam the screen reader. Visually
           hidden, screen-reader only. INSIDE
           .kiwi-widget — matching the Rust renderer and the driver's
           widget-local lookup (the sibling position would be a
           structural divergence). #}
        <span class="kiwi-sr-only" data-kiwi-status role="status" aria-live="polite"></span>
    </div>
</div>
{%- if asset_mode is defined and asset_mode == 'files' -%}
{# files mode: the stylesheet and the driver are emitted as versioned
   asset tags by the asset_tags block; the runtime and the worker stay
   lazy, the container carries data-kiwi-runtime-src / data-kiwi-worker-src
   and the driver fetches them only when a memory-hard challenge arrives #}
{%- else -%}
<script{% if nonce %} nonce="{{ nonce }}"{% endif %}>
{{ kiwi_wasm|raw }}
</script>
<script{% if nonce %} nonce="{{ nonce }}"{% endif %}>
{{ kiwi_driver|raw }}
</script>
{# The lazy widget modules of the driver split (inline tier): the
   adaptive-risk solve tier + armed-evidence module (widget-risk.js) is
   embedded on every inline page — a decoy or memory-hard challenge can
   be armed per response, and embedding keeps the tier's zero-request
   Blob-worker contract under CSPs that allow 'unsafe-inline' but not
   'self' — and the telemetry module (widget-telemetry.js) only when a
   session is enabled (the container's data-kiwi-telemetry says so).
   The locale packs (widget-locales.js) are NEVER embedded in this
   tier: the container carries the versioned module URL + SRI digest
   (data-kiwi-locales-src / data-kiwi-locales-integrity, like the
   execution interpreter) and the driver fetches them only when a
   non-default language is resolved, so a default-language page pays
   zero bytes for translations. #}
<script{% if nonce %} nonce="{{ nonce }}"{% endif %}>
{{ kiwi_risk|raw }}
</script>
{% if telemetry != 'off' %}<script{% if nonce %} nonce="{{ nonce }}"{% endif %}>
{{ kiwi_telemetry|raw }}
</script>
{% endif %}
{%- endif -%}
{% endblock %}
