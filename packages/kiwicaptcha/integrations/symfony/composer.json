{
    "name": "bel-consulting/kiwicaptcha-symfony",
    "description": "Self-contained Symfony bundle for KiwiCaptcha proof-of-work CAPTCHA. No external services, no tracking \u2014 challenges are issued and verified locally via the kiwicaptcha/kiwicaptcha-php core.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "captcha",
        "proof-of-work",
        "sha256",
        "argon2",
        "symfony",
        "security",
        "privacy"
    ],
    "authors": [
        {
            "name": "Bel Consulting O\u00dc",
            "email": "hello@bel.ee"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "kiwicaptcha/kiwicaptcha-php": "^1.0",
        "symfony/framework-bundle": "^6.0|^7.0",
        "symfony/form": "^6.0|^7.0",
        "symfony/validator": "^6.0|^7.0",
        "symfony/http-foundation": "^6.0|^7.0",
        "symfony/http-kernel": "^6.0|^7.0",
        "symfony/config": "^6.0|^7.0",
        "symfony/dependency-injection": "^6.0|^7.0",
        "symfony/twig-bridge": "^6.0|^7.0",
        "symfony/routing": "^6.0|^7.0",
        "psr/cache": "^3.0",
        "psr/log": "^3.0",
        "kiwicaptcha/kiwicaptcha-risk-php": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/cache": "^6.0|^7.0",
        "twig/twig": "^3.0",
        "symfony/twig-bundle": "^6.0|^7.0",
        "symfony/yaml": "^6.0|^7.0",
        "symfony/browser-kit": "^6.0|^7.0",
        "symfony/dom-crawler": "^6.0|^7.0",
        "predis/predis": "^3.5",
        "symfony/property-info": "^6.0|^7.0",
        "symfony/error-handler": "^6.0|^7.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../kiwicaptcha-php",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../../kiwicaptcha-risk-php",
            "options": {
                "symlink": false,
                "versions": {
                    "kiwicaptcha/kiwicaptcha-risk-php": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "BelConsulting\\KiwiCaptchaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BelConsulting\\KiwiCaptchaBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}