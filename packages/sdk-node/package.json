{
  "name": "@apexmail/node",
  "version": "1.0.0",
  "description": "Official Node.js SDK for ApexMail - Transactional Email API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "email",
    "transactional",
    "api",
    "apexmail",
    "smtp",
    "mail"
  ],
  "author": "Bel Consulting OÜ <contact@apexmail.ee>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bel-Consulting-OU/ApexMail"
  },
  "homepage": "https://apexmail.ee",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
