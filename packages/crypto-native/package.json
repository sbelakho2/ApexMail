{
  "name": "@apexmail/crypto-native",
  "version": "0.1.0",
  "description": "Native Node.js bindings for ApexMail cryptographic operations (AES-GCM, Argon2id, RSA, HKDF, HMAC)",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi build --platform --release"
  },
  "napi": {
    "name": "crypto-native",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin"
      ]
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "optionalDependencies": {
    "@apexmail/crypto-native-darwin-x64": "*",
    "@apexmail/crypto-native-darwin-arm64": "*",
    "@apexmail/crypto-native-linux-x64-gnu": "*",
    "@apexmail/crypto-native-linux-x64-musl": "*",
    "@apexmail/crypto-native-linux-arm64-gnu": "*"
  },
  "engines": {
    "node": ">=18"
  }
}
