{
  "name": "apexmail/apexmail-php",
  "description": "Official PHP SDK for the ApexMail transactional email API",
  "type": "library",
  "version": "1.0.1",
  "license": "MIT",
  "homepage": "https://apexmail.ee",
  "keywords": ["email", "transactional", "api", "sdk"],
  "support": {
    "issues": "https://github.com/Bel-Consulting-OU/ApexMail/issues",
    "source": "https://github.com/Bel-Consulting-OU/ApexMail/tree/main/packages/sdk-php"
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "ApexMail\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ApexMail\\Tests\\": "tests/"
    }
  }
}
