{
  "name": "@apexmail/pdf-native",
  "version": "0.1.0",
  "description": "napi-rs wrapper around Typst PDF compiler — generates PDFs from templates in Node.js",
  "main": "index.js",
  "types": "index.d.ts",
  "private": true,
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "napi": {
    "name": "pdf-native",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-apple-darwin"
      ]
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}
