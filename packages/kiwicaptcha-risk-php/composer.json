{
    "name": "kiwicaptcha/kiwicaptcha-risk-php",
    "description": "KiwiCaptcha Adaptive Risk Engine for PHP: privacy-first, self-hosted risk scoring for proof-of-work challenge issuance decisions, byte-identical with the cross-language risk-v1 contract.",
    "type": "library",
    "license": "MIT",
    "keywords": ["captcha", "risk", "proof-of-work", "sha256", "argon2", "security", "privacy", "adaptive"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "kiwicaptcha/kiwicaptcha-php": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "predis/predis": "^3.5",
        "symfony/cache": "^6.0|^7.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../kiwicaptcha-php",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "KiwiCaptcha\\Risk\\": "src/"
        },
        "classmap": [
            "src/Storage/LocalEmergencyStore.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "KiwiCaptcha\\Risk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev"
}
