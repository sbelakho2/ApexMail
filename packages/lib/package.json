{
  "name": "@apexmail/lib",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./logger": "./dist/logger/index.js",
    "./crypto": "./dist/crypto/index.js",
    "./storage": "./dist/storage/index.js",
    "./http": "./dist/http/index.js",
