{
  "name": "@apexmail/node",
  "version": "1.0.1",
  "description": "Official Node.js/TypeScript SDK for the ApexMail transactional email API",
  "license": "MIT",
  "author": "ApexMail",
  "homepage": "https://apexmail.ee",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bel-Consulting-OU/ApexMail.git",
    "directory": "packages/sdk-typescript"
  },
  "keywords": [
    "email",
    "transactional",
    "api",
    "apexmail",
    "smtp",
    "mail"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
