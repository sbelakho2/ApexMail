# =============================================================================
# ApexMail Production Environment Configuration
# =============================================================================
# Copy to .env only for local compose-style production testing. Real production
# deployments should source these values from a secret manager or orchestrator.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=production
RUST_LOG=info
RUST_BACKTRACE=0

# -----------------------------------------------------------------------------
# Public URLs and CORS
# -----------------------------------------------------------------------------
API_BASE_URL=https://api.apexmail.ee
APP_BASE_URL=https://app.apexmail.ee
TRACKING_BASE_URL=https://track.apexmail.ee
CORS_ORIGINS=https://app.apexmail.ee,https://admin.apexmail.ee
# XFF trust (F10): trust ONLY the Docker bridge subnets the compose networks
# actually use — the same defaults docker-compose.prod.yml gives api-server
# (172.18/20/21.0.0/16 = frontend/backend/data bridges). Do NOT widen this
# to all of RFC1918 (10/8, 172.16/12, 192.168/16): every client inside those
# ranges could then SPOOF X-Forwarded-For and defeat per-IP rate limiting
# (one global bucket for attackers, or unlimited fresh identities).
TRUSTED_PROXIES=172.18.0.0/16,172.20.0.0/16,172.21.0.0/16

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=apexmail
POSTGRES_USER=apexmail
POSTGRES_PORT=
DATABASE_URL=postgresql://apexmail:<REQUIRED-POSTGRES_PASSWORD>@postgres:5432/apexmail?sslmode=disable
DB_MAX_CONNECTIONS=50

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Host binding for the Redis container. Keep it loopback-only: Redis must
# never be exposed on 0.0.0.0. Production compose clears ports entirely
# (`ports: !override []` in docker-compose.prod.yml), so this is defense in
# depth for any deploy that runs the base compose without the prod overlay.
REDIS_PORT=127.0.0.1:6379
# In-container Redis URL (service name `redis` on the compose network).
REDIS_URL=redis://:<REQUIRED-REDIS_PASSWORD>@redis:6379/0
REDIS_POOL_SIZE=16
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=volatile-lru

# -----------------------------------------------------------------------------
# ClickHouse
# -----------------------------------------------------------------------------
# In-container ClickHouse URL (service name `clickhouse` on the compose network).
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=apexmail
CLICKHOUSE_USER=apexmail
CLICKHOUSE_MAX_CONNECTIONS=20
# Audit I — SEPARATE admin credential (user apexmail_admin, the only one with
# access_management) rendered to secrets/clickhouse_admin_password.txt by
# deploy-hetzner.yml. Must differ from CLICKHOUSE_PASSWORD.
CLICKHOUSE_ADMIN_PASSWORD=<REQUIRED-openssl-rand-base64-24>

# -----------------------------------------------------------------------------
# API Server Authentication
# -----------------------------------------------------------------------------
# The Rust API server signs dashboard/session JWTs with RS256. Generate an RSA
# key pair and store the PEM values in your orchestrator secret backend.
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n<REQUIRED-PASTE-REAL-PEM-BODY>\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n<REQUIRED-PASTE-REAL-PEM-BODY>\n-----END PUBLIC KEY-----"

# Audit B — REQUIRED in production, enforced by
# ${APEXMAIL_API_KEY:?} in docker-compose.prod.yml (the development default
# `dev-api-key-change-me` must never reach a production deployment).
APEXMAIL_API_KEY=<REQUIRED-openssl-rand-base64-32>

# Enterprise service still validates its own internal HS256 token until that
# service migrates to the API server RSA verifier. Keep it distinct from API JWTs.
# REQUIRED in production — enforced by ${JWT_SECRET:?} in docker-compose.prod.yml;
# must be at least 32 characters.
JWT_SECRET=<REQUIRED-openssl-rand-base64-32>

# -----------------------------------------------------------------------------
# Internal Service Secrets
# -----------------------------------------------------------------------------
INTERNAL_SERVICE_TOKEN=<REQUIRED-openssl-rand-base64-32>
API_KEY_HASH_SECRET=<REQUIRED-openssl-rand-base64-32>
WEBHOOK_SIGNING_SECRET=<REQUIRED-openssl-rand-base64-32>
TRACKING_SECRET_KEY=<REQUIRED-openssl-rand-base64-32>
# HMAC-SHA256 key signing the audit-log hash chain (billing + compliance).
# REQUIRED in production — services fail closed (empty signatures) without it.
# Rendered to the audit_signing_key Docker secret via PROD_AUDIT_SIGNING_KEY_FILE.
AUDIT_SIGNING_KEY=<REQUIRED-openssl-rand-hex-32>

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
API_PORT=3000
TRACKING_PORT=3001
TRACKING_METRICS_PORT=9092
ENTERPRISE_PORT=3002
OBSERVABILITY_PORT=4400
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
# Compliance service (internal-only; served at compliance:3011 on the compose
# network, never published to the host).
COMPLIANCE_PORT=3011

# -----------------------------------------------------------------------------
# Billing
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_<REQUIRED-if-billing-enabled>
STRIPE_WEBHOOK_SECRET=whsec_<REQUIRED-if-billing-enabled>
STRIPE_PRICE_STARTER=price_<REQUIRED-if-billing-enabled>
STRIPE_PRICE_GROWTH=price_<REQUIRED-if-billing-enabled>
STRIPE_PRICE_SCALE=price_<REQUIRED-if-billing-enabled>

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=tempo:4317
OTEL_SERVICE_NAME=apexmail
SYNTHETIC_TARGETS=https://api.apexmail.ee/health,https://track.apexmail.ee/
SYNTHETIC_INTERVAL_SECONDS=60
SYNTHETIC_TIMEOUT_SECONDS=10

# Observability service itself: Prometheus scrape endpoint on :4400/metrics,
# Redis eviction monitoring connects via the internal `redis` service using
# the shared redis_password Docker secret (REDIS_PASSWORD_FILE).
OBSERVABILITY_PORT=4400
REDIS_DB=0

# -----------------------------------------------------------------------------
# Grafana Monitoring Profile
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<REQUIRED-openssl-rand-base64-24>

# -----------------------------------------------------------------------------
# Optional embedding and sales services
# -----------------------------------------------------------------------------
AI_EMBEDDINGS_PORT=3301
SALES_ENRICHMENT_API_URL=
# ── Sales Autopilot (internal engine on the compose network, port 3010) ────
# Campaign dispatch. SALES_CAMPAIGN_FROM_EMAIL is REQUIRED in production
# (enforced by docker-compose.prod.yml): its domain must be a verified,
# DKIM-ready sending domain for every allowed tenant.
SALES_CAMPAIGN_FROM_EMAIL=<REQUIRED-e.g.-sales@apexmail.ee>
SALES_CAMPAIGN_FROM_NAME=ApexMail
SALES_UNSUBSCRIBE_SECRET=<REQUIRED-openssl-rand-base64-32>
# Public base for unsubscribe links. The nginx edge routes ONLY
# {SALES_PUBLIC_BASE_URL}/u/{token} to the service (api vhost, /sales-api/
# prefix — a bare /sales/ prefix would collide with the control-plane page).
SALES_PUBLIC_BASE_URL=https://api.apexmail.ee/sales-api
SALES_UNSUBSCRIBE_REDIRECT_URL=
# Optional comma-separated tenant allowlist (recommended: scopes the
# shared-token service's cross-tenant blast radius).
SALES_ALLOWED_TENANTS=
ENRICHMENT_API_KEY=
SALES_DISPATCH_INTERVAL_SECS=30
SALES_DISPATCH_BATCH_SIZE=100
SALES_DISPATCH_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Compliance service (audit log, DSR/GDPR automation, secrets rotation)
# -----------------------------------------------------------------------------
# Internal bearer-token service on the compose network (port 3011). Secret
# VALUES below are rendered into the files named by the PROD_COMPLIANCE_* /
# PROD_AUDIT_SIGNING_KEY vars above and mounted as Docker secrets.
COMPLIANCE_AUTH_TOKEN=<REQUIRED-openssl-rand-base64-32>
COMPLIANCE_SECRETS_ENCRYPTION_KEY=<REQUIRED-openssl-rand-base64-32>
COMPLIANCE_SECRETS_KDF_SALT=<REQUIRED-openssl-rand-base64-16>
COMPLIANCE_CONSENT_SIGNING_KEY=<REQUIRED-openssl-rand-base64-32>
# Optional CORS allow-list (comma-separated origins; empty = same-origin only).
COMPLIANCE_CORS_ORIGIN=
# Optional public base URLs used in GDPR export/verify links.
GDPR_EXPORT_BASE_URL=
GDPR_VERIFY_BASE_URL=
# Optional audit-log retention (days) before archival purges entries.
AUDIT_RETENTION_DAYS=
# ClickHouse GDPR erasure: when "true", DSR erasure also purges analytics rows
# (CLICKHOUSE_* connection vars are shared with the rest of the stack).
GDPR_CLICKHOUSE_ERASURE_ENABLED=false

# -----------------------------------------------------------------------------
# Worker engagement tracking + VERP bounce routing
# -----------------------------------------------------------------------------
# TRACKING_ENABLED gates the delivery worker's pixel/link rewriting (campaign
# engagement accounting is dead without it). The secret is the SAME
# tracking_secret_key Docker secret the tracking-service verifies tokens with.
TRACKING_ENABLED=true
# Envelope Return-Path domain for bounces+{message_id}=... addresses on the
# SMTP transport — MUST equal the MTA bounce server's VERP_DOMAIN.
VERP_DOMAIN=bounces.apexmail.ee

# -----------------------------------------------------------------------------
# KiwiCaptcha (Native Rust Proof-of-Work CAPTCHA)
# -----------------------------------------------------------------------------
# ApexMail's first-party proof-of-work CAPTCHA. No external service — the
# widget is an inline nonce'd script that solves a SHA-256 (or memory-hard
# Argon2id) proof-of-work via an embedded WASM solver with a JS fallback.
# Challenges are HMAC-signed, single-use, IP-bound, and TTL'd (stored in Redis),
# and the algorithm is carried explicitly on every challenge.
#
# Set to "true" to require CAPTCHA challenges on auth routes.
KIWI_ENABLED=true
# HMAC secret key for signing/verifying challenges (min 16 chars in prod).
KIWI_SECRET_KEY=<REQUIRED-random-16+-char-hmac-secret>
# Proof-of-work algorithm: "sha256" (default, fast verify, high difficulty) or
# "argon2id" (memory-hard, ASIC/GPU resistant). Decided explicitly — never
# inferred from a numeric flag.
KIWI_ALGORITHM=sha256
# Argon2id memory cost in KiB (only for KIWI_ALGORITHM=argon2id). Must be
# >= 8 * KIWI_ARGON_P and browser-solvable (<= 65536). Ignored for SHA-256.
# Legacy env name KIWI_PBKDF2_ITERATIONS is still accepted.
KIWI_ARGON_M_KIB=0
# Argon2id time cost and parallelism (only for argon2id mode).
KIWI_ARGON_T=1
KIWI_ARGON_P=1
# Required leading zero bits for SHA-256 challenges (difficulty).
# 20 bits = ~1M expected hashes = ~2-5s solve on a browser.
KIWI_DIFFICULTY_BITS=20
# Required leading zero bits for Argon2id challenges. Memory-hard hashes are
# ~1000x slower than SHA-256, so the difficulty must be far lower (max 10).
KIWI_ARGON2_DIFFICULTY_BITS=8
# Challenge lifetime in seconds.
KIWI_CHALLENGE_TTL_SECS=120

# -----------------------------------------------------------------------------
# Dedicated IP / SES Email Transport
# -----------------------------------------------------------------------------
# AWS IAM credentials for SES. Create an IAM user with the ApexMail SES policy
# (see docs/deployment/ses-setup.md) and set both values.
# Audit G — in production these are rendered to secret FILES
# (secrets/aws_access_key_id.txt / aws_secret_access_key.txt) and bridged to
# the containers via the entrypoint wrapper; they never appear as plain
# container environment values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS region for SES API calls. The API server and worker must use the same
# region because SES identities are regional.
AWS_REGION=eu-west-1
# SES configuration set for event tracking (open/click/bounce). Leave empty if
# not yet configured in the AWS console.
SES_CONFIGURATION_SET=
# SES dedicated IP pool prefix (NOT USED — ApexMail uses Hetzner floating IPs for dedicated sending)
SES_IP_POOL_PREFIX=apexmail
# SES dedicated IP warmup days (NOT USED — see HETZNER_* vars for dedicated IP warmup)
SES_DEFAULT_WARMUP_DAYS=14
# Email transport mode: "ses" (default) or "smtp". SMTP is an explicit
# deployment mode and still requires each sender domain's encrypted DKIM key.
EMAIL_TRANSPORT_TYPE=ses
# Audit G — direct-SMTP credentials for the worker (EMPTY when running the
# SES transport; the files are still rendered, empty, so the compose secret
# guards stay satisfied).
SMTP_USERNAME=
SMTP_PASSWORD=

# Hetzner Cloud API — dedicated IP provisioning for outbound mail.
# Required for dedicated IP allocation. Omit or leave empty to disable Hetzner
# integration (the deployment remains in its explicit SES transport mode).
HETZNER_API_TOKEN=
# Default Hetzner datacenter location for new floating IPs (e.g., fsn1, nbg1, hel1).
HETZNER_DEFAULT_LOCATION=fsn1
# Hetzner server ID to assign floating IPs to. Required for single-server setups;
# leave empty for multi-server / orchestrator-managed environments.
HETZNER_MTA_SERVER_ID=

# -----------------------------------------------------------------------------
# Required Secrets (generate unique values per deployment)
# -----------------------------------------------------------------------------
# These secrets are validated with the ${VAR:?error} pattern in the production
# Docker Compose file and must be set to unique, cryptographically-random
# values for each deployment. They are used for session signing, CSRF
# protection, and admin impersonation.
IMPERSONATION_SECRET=<REQUIRED-openssl-rand-base64-32>  # openssl rand -base64 32
SESSION_SECRET=<REQUIRED-openssl-rand-base64-32>        # openssl rand -base64 32
CSRF_SECRET=<REQUIRED-openssl-rand-base64-32>           # openssl rand -base64 32
# REQUIRED: 32-byte AES-256 key encoded as exactly 64 hexadecimal characters.
# Both api-server and worker use it to encrypt/decrypt per-domain DKIM keys.
DKIM_PRIVATE_KEY_ENCRYPTION_KEY=<REQUIRED-openssl-rand-hex-32>
# Set to true for one controlled API startup to provision encrypted platform
# DKIM material. This does not authorize delivery; verify after publishing DNS.
SYSTEM_SENDER_BOOTSTRAP_ON_STARTUP=false

# -----------------------------------------------------------------------------
# Required for the production overlay (${VAR:?} checks in docker-compose.prod.yml)
# -----------------------------------------------------------------------------
BASE_URL=https://apexmail.ee
OAUTH_REDIRECT_BASE_URL=https://app.apexmail.ee
# Placement/encryption domain key used by the API server's placement engine.
PLACEMENT_ENCRYPTION_SECRET=<REQUIRED-openssl-rand-base64-32>
BILLING_COMPANY_IBAN=      # e.g. EE38 2200 2210 1111 2222
BILLING_COMPANY_PHONE=     # e.g. +372 0000 0000

# -----------------------------------------------------------------------------
# Secret VALUES that .github/workflows/deploy-hetzner.yml renders into the
# secret files referenced by the PROD_*_FILE vars below (one pair per secret).
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=<REQUIRED-openssl-rand-base64-24>     # openssl rand -base64 24
REDIS_PASSWORD=<REQUIRED-openssl-rand-base64-24>        # openssl rand -base64 24
CLICKHOUSE_PASSWORD=<REQUIRED-openssl-rand-base64-24>   # openssl rand -base64 24
# Audit I — separate ClickHouse admin password (access_management user).
CLICKHOUSE_ADMIN_PASSWORD=<REQUIRED-openssl-rand-base64-24>
# Audit E — key encrypting the pg_dump backups (postgres-backup service).
BACKUP_ENCRYPTION_KEY=<REQUIRED-openssl-rand-base64-32>
# Audit G — optional-valued secrets (empty files are rendered when unset,
# e.g. while running the SES transport instead of direct SMTP).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMTP_USERNAME=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Backups (postgres-backup service; audit E)
# -----------------------------------------------------------------------------
# Keep the newest N encrypted backups (count-based retention on top of the
# day/week/month pruning).
BACKUP_KEEP_COUNT=30
# Optional offsite mirror for the encrypted backups (rsync over ssh), e.g.
#   BACKUP_TARGET=backup-user@offsite.example:/srv/apexmail-backups
# Leave empty to disable; the container needs the matching ssh key mounted.
BACKUP_TARGET=

# -----------------------------------------------------------------------------
# PROD_*_FILE paths (must point at the files deploy-hetzner.yml writes to on
# the host; the workflow reads each PROD_*_FILE value from this .env and writes
# the corresponding secret value to exactly that path).
# -----------------------------------------------------------------------------
PROD_POSTGRES_PASSWORD_FILE=/opt/apexmail/secrets/postgres_password.txt
PROD_REDIS_PASSWORD_FILE=/opt/apexmail/secrets/redis_password.txt
PROD_CLICKHOUSE_PASSWORD_FILE=/opt/apexmail/secrets/clickhouse_password.txt
PROD_CLICKHOUSE_ADMIN_PASSWORD_FILE=/opt/apexmail/secrets/clickhouse_admin_password.txt
PROD_API_KEY_HASH_SECRET_FILE=/opt/apexmail/secrets/api_key_hash_secret.txt
PROD_WEBHOOK_SIGNING_SECRET_FILE=/opt/apexmail/secrets/webhook_signing_secret.txt
PROD_TRACKING_SECRET_KEY_FILE=/opt/apexmail/secrets/tracking_secret_key.txt
PROD_INTERNAL_SERVICE_TOKEN_FILE=/opt/apexmail/secrets/internal_service_token.txt
PROD_JWT_SECRET_FILE=/opt/apexmail/secrets/jwt_secret.txt
PROD_JWT_PRIVATE_KEY_FILE=/opt/apexmail/secrets/jwt_private_key_pem.txt
PROD_JWT_PUBLIC_KEY_FILE=/opt/apexmail/secrets/jwt_public_key_pem.txt
PROD_SESSION_SECRET_FILE=/opt/apexmail/secrets/session_secret.txt
PROD_IMPERSONATION_SECRET_FILE=/opt/apexmail/secrets/impersonation_secret.txt
PROD_CSRF_SECRET_FILE=/opt/apexmail/secrets/csrf_secret.txt
PROD_DKIM_PRIVATE_KEY_ENCRYPTION_KEY_FILE=/opt/apexmail/secrets/dkim_private_key_encryption_key.txt
PROD_KIWI_SECRET_KEY_FILE=/opt/apexmail/secrets/kiwi_secret_key.txt
# Stripe credentials for billing-service (compose secrets stripe_secret_key /
# stripe_webhook_secret — the webhook secret is mandatory; the billing binary
# fail-fasts at startup without it).
PROD_STRIPE_SECRET_KEY_FILE=/opt/apexmail/secrets/stripe_secret_key.txt
PROD_STRIPE_WEBHOOK_SECRET_FILE=/opt/apexmail/secrets/stripe_webhook_secret.txt
PROD_AWS_ACCESS_KEY_ID_FILE=/opt/apexmail/secrets/aws_access_key_id.txt
PROD_AWS_SECRET_ACCESS_KEY_FILE=/opt/apexmail/secrets/aws_secret_access_key.txt
PROD_SMTP_USERNAME_FILE=/opt/apexmail/secrets/smtp_username.txt
PROD_SMTP_PASSWORD_FILE=/opt/apexmail/secrets/smtp_password.txt
# HMAC key signing sales campaign unsubscribe tokens (>= 32 chars).
PROD_SALES_UNSUBSCRIBE_SECRET_FILE=/opt/apexmail/secrets/sales_unsubscribe_secret.txt
PROD_BACKUP_ENCRYPTION_KEY_FILE=/opt/apexmail/secrets/backup_encryption_key.txt
# ── Compliance service (F13): file-based secrets for the compose service ────
PROD_AUDIT_SIGNING_KEY_FILE=/opt/apexmail/secrets/audit_signing_key.txt
PROD_COMPLIANCE_AUTH_TOKEN_FILE=/opt/apexmail/secrets/compliance_auth_token.txt
PROD_COMPLIANCE_SECRETS_ENCRYPTION_KEY_FILE=/opt/apexmail/secrets/compliance_secrets_encryption_key.txt
PROD_COMPLIANCE_SECRETS_KDF_SALT_FILE=/opt/apexmail/secrets/compliance_secrets_kdf_salt.txt
PROD_COMPLIANCE_CONSENT_SIGNING_KEY_FILE=/opt/apexmail/secrets/compliance_consent_signing_key.txt

# Comma-separated CIDRs of trusted reverse proxies (the nginx edge and any
# upstream LB). Only these peers' X-Forwarded-For/X-Real-IP headers are
# honored for client-IP extraction by the DDoS/WAF layer; empty means
# headers are never trusted (correct for direct exposure only).
# Example for the compose network edge: 172.20.0.0/16,127.0.0.1
DDOS_TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# SES SNS notifications
# -----------------------------------------------------------------------------
# Comma-separated allow-list of SNS topic ARNs accepted by the api-server
# POST /v1/ses/notifications handler. WARNING: while unset, EVERY
# notification is rejected with 503 — message status never flips to
# delivered/bounced, bounces/complaints are never auto-suppressed, and
# tenant webhooks never fire (see deploy/DEPLOYMENT.md § "SES configuration
# set + SNS event destinations" for the one-time AWS setup).
SNS_ALLOWED_TOPIC_ARNS=

# REQUIRED in production (enterprise :? guard) — encrypts log-stream destination credentials
LOG_STREAM_ENCRYPTION_KEY=<REQUIRED-openssl-rand-base64-36>
