{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://apexmail.ee/schemas/design-token-baseline.json",
  "title": "ApexMail Design Token Baseline",
  "description": "Validates the structure of ui-design-token-baseline.json",
  "type": "object",
  "required": ["version", "surfaces"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Schema version number",
      "minimum": 1
    },
    "surfaces": {
      "type": "object",
      "description": "Surface-specific design tokens",
      "patternProperties": {
        "^[a-z-]+$": {
          "type": "object",
          "required": ["sources", "colors"],
          "properties": {
            "sources": {
              "type": "array",
              "description": "Source files for the design tokens",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "colors": {
              "type": "array",
              "description": "Color token definitions",
              "items": {
                "$ref": "#/definitions/ColorToken"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "minProperties": 1
    }
  },
  "definitions": {
    "ColorToken": {
      "type": "object",
      "required": ["source", "name", "value"],
      "properties": {
        "source": {
          "type": "string",
          "description": "Source file where the token is defined"
        },
        "name": {
          "type": "string",
          "description": "CSS variable name (e.g., --background)",
          "pattern": "^--[a-z-]+$"
        },
        "value": {
          "type": "string",
          "description": "Token value (e.g., RGB triplet '255 255 255')"
        }
      },
      "additionalProperties": false
    }
  }
}
