# =============================================================================
# ApexMail Worker Service Dockerfile
# =============================================================================
# Handles email sending, webhooks, and analytics processing
# Build: docker build -t apexmail-worker -f Dockerfile.worker .
# =============================================================================

# Stage 1: Builder
FROM node:20-alpine AS builder

# Install pnpm
RUN npm install -g pnpm@8.14.0

WORKDIR /app

# Copy package files for dependency installation
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json turbo.json ./

# Copy package.json files for all workspaces
COPY packages/lib/package.json packages/lib/
COPY packages/db/package.json packages/db/
COPY apps/worker/package.json apps/worker/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Copy source files
COPY packages/lib packages/lib/
COPY packages/db packages/db/
COPY apps/worker apps/worker/

# Build packages in dependency order
RUN pnpm --filter @apexmail/lib build && \
    pnpm --filter @apexmail/db build && \
    pnpm --filter @apexmail/worker build

# Use pnpm deploy for clean production output (pnpm prune is unreliable in workspaces)
RUN pnpm --filter @apexmail/worker deploy --prod /app/deploy

# Stage 2: Production
FROM node:20-alpine AS production

# Install tini for proper PID 1 signal handling (zombie reaping, SIGTERM forwarding)
RUN apk add --no-cache tini

# Security: Don't run as root
RUN addgroup -g 1001 apexmail && \
    adduser -u 1001 -G apexmail -s /bin/sh -D apexmail

WORKDIR /app

# Copy production deployment (created by pnpm deploy)
COPY --from=builder --chown=apexmail:apexmail /app/deploy/node_modules ./node_modules
COPY --from=builder --chown=apexmail:apexmail /app/packages/lib/dist ./packages/lib/dist
COPY --from=builder --chown=apexmail:apexmail /app/packages/lib/package.json ./packages/lib/
COPY --from=builder --chown=apexmail:apexmail /app/packages/db/dist ./packages/db/dist
COPY --from=builder --chown=apexmail:apexmail /app/packages/db/package.json ./packages/db/
COPY --from=builder --chown=apexmail:apexmail /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder --chown=apexmail:apexmail /app/apps/worker/package.json ./apps/worker/

USER apexmail

# Expose metrics port
EXPOSE 9090

# Health check via metrics endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:9090/metrics || exit 1

# Set environment
ENV NODE_ENV=production

# Start the Worker with tini as init process
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/worker/dist/index.js"]
