# =============================================================================
# ApexMail Tracking Service – Rust multi-stage Dockerfile
# =============================================================================
# Build context must be the repo root:
#   docker build -t apexmail-tracking -f Dockerfile.tracking .
#
# Stage layout
#   deps     – compile *only* workspace dependency crates (cacheable layer)
#   builder  – compile tracking-service with real source
#   runtime  – minimal Debian Slim image, runs as unprivileged user
# =============================================================================

# ── Stage 1: dependency cache ──────────────────────────────────────────────────
FROM rust:1.82.0-slim-bookworm AS deps

# Build-time packages needed by ring / openssl-sys / etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace manifest + lockfile first (invalidated only on dep changes)
COPY services/mail-server/Cargo.toml  services/mail-server/Cargo.lock  ./

# Re-create the crate tree with stub sources so cargo can resolve + compile deps
# without touching the real application source.
COPY services/mail-server/crates/mail-common/Cargo.toml   crates/mail-common/Cargo.toml
COPY services/mail-server/crates/mail-proto/Cargo.toml    crates/mail-proto/Cargo.toml
COPY services/mail-server/crates/mailstore-core/Cargo.toml crates/mailstore-core/Cargo.toml
COPY services/mail-server/crates/outbound-queue/Cargo.toml crates/outbound-queue/Cargo.toml
COPY services/mail-server/crates/smtp-edge/Cargo.toml     crates/smtp-edge/Cargo.toml
COPY services/mail-server/crates/submission/Cargo.toml    crates/submission/Cargo.toml
COPY services/mail-server/crates/tracking-service/Cargo.toml crates/tracking-service/Cargo.toml

# Create minimal stub lib/main for every crate so cargo can pre-compile all deps
RUN for crate in mail-common mail-proto mailstore-core outbound-queue smtp-edge submission; do \
        mkdir -p crates/$crate/src && echo "// stub" > crates/$crate/src/lib.rs; \
    done && \
    mkdir -p crates/tracking-service/src && \
    printf 'fn main() {}' > crates/tracking-service/src/main.rs

# Compile deps only (the stub sources will be replaced in the next stage)
RUN cargo build --release -p tracking-service
# Remove stub artefacts so the real build re-compiles only the crate code
RUN find target/release -name "tracking_service*" -not -path "*/deps/*" -delete && \
    find target/release/deps -name "tracking_service*" -delete

# ── Stage 2: real build ────────────────────────────────────────────────────────
FROM deps AS builder

# Overwrite stub sources with the actual workspace source
COPY services/mail-server/crates ./crates/

# Build the release binary – deps are already compiled, only crate code rebuilds
RUN cargo build --release -p tracking-service

# ── Stage 3: minimal runtime image ────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

# Runtime dependencies: CA certs for TLS outbound, tini for PID-1 hygiene
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tini \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Unprivileged service account (UID/GID 10001 avoids clash with system users)
RUN groupadd -g 10001 apexmail && \
    useradd  -u 10001 -g apexmail -s /sbin/nologin -M apexmail

COPY --from=builder /build/target/release/tracking-service /usr/local/bin/tracking-service
RUN chmod 0755 /usr/local/bin/tracking-service

USER apexmail
WORKDIR /

EXPOSE 3001

# Health-check via the /health endpoint exposed by the Axum router
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD ["sh", "-c", "wget -qO- http://localhost:3001/health || exit 1"]

# tini as PID-1 handles zombie reaping and forwards SIGTERM to the service
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/tracking-service"]
