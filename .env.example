# =============================================================================
# ApexMail Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env files with real credentials to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
# Application port configuration - each app runs on a different port
API_PORT=3000
TRACKING_PORT=3001
ANALYTICS_PORT=3002
MTA_INBOUND_PORT=25
MTA_BOUNCE_PORT=2525
MTA_FBL_PORT=2526

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://apexmail:apexmail@localhost:5432/apexmail
DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# For read replicas (optional)
DATABASE_REPLICA_URL=

# -----------------------------------------------------------------------------
# Redis Cache & Queue
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_MS=500

# For Redis Cluster (optional)
REDIS_CLUSTER_NODES=

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# JWT secret for API authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-at-least-32-characters
JWT_EXPIRY=1h

# SMTP password salt for credential hashing
SMTP_PASSWORD_SALT=your-smtp-password-salt

# API key prefix
API_KEY_PREFIX=ak_

# -----------------------------------------------------------------------------
# Tracking Service
# -----------------------------------------------------------------------------
# 128-bit hex key for tracking ID encryption (generate with: openssl rand -hex 16)
TRACKING_ENCRYPTION_KEY=your-tracking-encryption-key
# 256-bit hex key for tracking signatures (generate with: openssl rand -hex 32)
TRACKING_SIGNATURE_KEY=your-tracking-signature-key

# External URL for tracking pixels/links (must be publicly accessible)
TRACKING_BASE_URL=https://track.yourdomain.com

# -----------------------------------------------------------------------------
# DKIM Signing
# -----------------------------------------------------------------------------
# Default DKIM selector (domains can override)
DKIM_DEFAULT_SELECTOR=mx
# Path to DKIM private key (or inline key)
DKIM_PRIVATE_KEY_PATH=/etc/apexmail/dkim/default.pem

# -----------------------------------------------------------------------------
# Object Storage (S3/MinIO/R2)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_EVENTS=apexmail-events
S3_BUCKET_ATTACHMENTS=apexmail-attachments
# Force path-style URLs (required for MinIO)
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_BURST_MULTIPLIER=2

# -----------------------------------------------------------------------------
# Email Sending
# -----------------------------------------------------------------------------
# MX server hostname (must match your PTR record)
MX_HOSTNAME=mx.yourdomain.com
# IP pool for outbound mail (comma-separated)
OUTBOUND_IP_POOL=

# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------
WEBHOOK_MAX_RETRIES=5
WEBHOOK_INITIAL_DELAY_MS=1000
WEBHOOK_MAX_DELAY_MS=300000
WEBHOOK_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
# Path for local Parquet file storage before S3 upload
PARQUET_LOCAL_PATH=/var/lib/apexmail/parquet
# Days to keep events in hot storage before compaction
COMPACTION_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Monitoring & Observability (optional)
# -----------------------------------------------------------------------------
# OpenTelemetry endpoint for traces
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sentry DSN for error tracking
SENTRY_DSN=
# Prometheus pushgateway for metrics
PROMETHEUS_PUSHGATEWAY_URL=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_IP_WARMUP=true
FEATURE_DKIM_SIGNING=true
FEATURE_SPF_VALIDATION=true
FEATURE_INBOUND_EMAIL=false
