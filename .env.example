# ApexMail Development Environment Configuration
# =============================================================================
# Copy this file to .env and customise for local development:
#   cp .env.example .env
#
# WARNING: Never commit the actual .env file. It contains local overrides and
# secrets that must stay out of version control.
#
# SECRET MANAGEMENT:
#   Values marked with *** are secrets. For production, use Docker secrets
#   (see deploy/load-secret-env.sh) or a dedicated secret manager (Vault, K8s Secrets).
#   In development, replace *** with locally-generated values.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=apexmail
POSTGRES_PASSWORD=***  # Generate: openssl rand -base64 32
POSTGRES_DB=apexmail
POSTGRES_PORT=127.0.0.1:5432
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apexmail
DB_USER=apexmail
DB_PASSWORD=***  # Same as POSTGRES_PASSWORD for dev convenience
DB_MAX_CONNECTIONS=20
API_REPLICA_COUNT=1
DB_CLUSTER_CONNECTION_BUDGET=

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=***  # Generate: openssl rand -base64 32
REDIS_PORT=127.0.0.1:6379
REDIS_HOST=localhost
REDIS_DB=0
REDIS_POOL_MAX_SIZE=40

# ── ClickHouse ──────────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=***  # Generate: openssl rand -base64 32
CLICKHOUSE_PORT=127.0.0.1:9000
CLICKHOUSE_HTTP_PORT=127.0.0.1:8123

# ── API Server ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
HOST=0.0.0.0
PORT=3000
BASE_URL=http://localhost:3000
CORS_ORIGINS=*
TRUSTED_PROXIES=
MAX_INFLIGHT_REQUESTS=30
METRICS_PORT=9090
APEXMAIL_API_PORT=3000
APEXMAIL_API_BASE_URL=http://localhost:3000

# JWT keys are required even in development; use escaped newlines if storing in .env.
# SECURITY: These are RSA key pairs for RS256 JWT signing. Never commit real keys.
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n***\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n***\n-----END PUBLIC KEY-----"
JWT_PREVIOUS_PUBLIC_KEYS_PEM=
JWT_EXPIRY=24h
API_KEY_HASH_SECRET=***  # Generate: openssl rand -base64 32
WEBHOOK_SIGNING_SECRET=***  # Generate: openssl rand -base64 32
SESSION_SECRET=***  # Generate: openssl rand -base64 32
IMPERSONATION_SECRET=***  # Generate: openssl rand -base64 32
CSRF_SECRET=***  # Generate: openssl rand -base64 32
TRACKING_SECRET_KEY=***  # Generate: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=***  # Generate: openssl rand -base64 32
CONTROL_PLANE_API_KEY=***  # Generate: openssl rand -base64 32

# UI host routing
UI_WEB_HOSTS=localhost,127.0.0.1,app.apexmail.ee
UI_CONTROL_PLANE_HOSTS=admin.apexmail.ee,control.apexmail.ee
UI_MARKETING_HOSTS=apexmail.ee,www.apexmail.ee
UI_MARKETING_SURFACE=marketing-zola
UI_DEFAULT_SURFACE=web

# API protection
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000
IDEMPOTENCY_TTL_SECONDS=86400

# ── Email Grader ────────────────────────────────────────────────────────────
GRADER_ENABLED=true
GRADER_RATE_LIMIT=10
GRADER_RATE_WINDOW=3600
GRADER_CACHE_TTL=300
GRADER_MAX_BODY_SIZE=1048576

# ── Inbox Placement ─────────────────────────────────────────────────────────
PLACEMENT_ENABLED=true
PLACEMENT_POLLING_INTERVAL=60
PLACEMENT_MAX_POLLING_ATTEMPTS=10
PLACEMENT_MAX_SEEDS_PER_TEST=50
PLACEMENT_MAX_TESTS_PER_HOUR=5
PLACEMENT_IMAP_TIMEOUT=30
PLACEMENT_ENCRYPT_PASSWORDS=true
PLACEMENT_ENCRYPTION_SECRET=***  # Generate: openssl rand -base64 32

# ── Outbound Queue ──────────────────────────────────────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# ── Dedicated IP / SES ──────────────────────────────────────────────────────
AWS_REGION=us-east-1
SES_IP_POOL_PREFIX=apexmail
SES_DEFAULT_WARMUP_DAYS=14
SES_CONFIGURATION_SET=
HETZNER_API_TOKEN=***  # Your Hetzner API token
HETZNER_DEFAULT_LOCATION=fsn1
HETZNER_MTA_SERVER_ID=

# ── OAuth / SSO ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=***  # Your Google OAuth client secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=***  # Your GitHub OAuth client secret
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# ── Billing ────────────────────────────────────────────────────────────────
BILLING_COMPANY_IBAN=UNCONFIGURED
BILLING_COMPANY_PHONE=UNCONFIGURED

# ── mCaptcha CAPTCHA ─────────────────────────────────────────────────────────
# Privacy-preserving, proof-of-work based CAPTCHA integration.
# See: https://mcaptcha.org/docs/
#
# Enable/disable mCaptcha verification globally. Set to "true" to enforce
# CAPTCHA challenges on login/signup routes.
MCAPTCHA_ENABLED=false
# mCaptcha site key rendered in the CAPTCHA widget.
MCAPTCHA_SITE_KEY=dev
# mCaptcha secret for server-side token verification. In development set to
# "dev" to bypass verification locally.
MCAPTCHA_SECRET_KEY=dev
# mCaptcha verification endpoint URL. For local development, point at a local
# mCaptcha instance; in production, use the self-hosted or SaaS mCaptcha URL.
MCAPTCHA_VERIFY_URL=http://localhost:5001/api/v1/verify

# ── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ANALYTICS_IMAGE_SRC=
MARKETING_PUBLIC_DIR=apps/marketing-zola/public

# ── Composite Connection Strings (derived from individual vars above) ───────
# These are convenience aliases. The application also accepts individual
# DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD for the PostgreSQL connection
# and REDIS_HOST/REDIS_PORT for Redis.
# SECURITY: These contain embedded passwords — keep .env out of version control.
DATABASE_URL=postgresql://apexmail:***@localhost:5432/apexmail
REDIS_URL=redis://:***@localhost:6379/0

# ── Storage ─────────────────────────────────────────────────────────────────
# S3-compatible storage endpoint for attachments and exports.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=apexmail-dev
S3_ACCESS_KEY_ID=***  # Your S3 access key
S3_SECRET_ACCESS_KEY=***  # Your S3 secret key

# ── Tracking (Encryption & Signing) ─────────────────────────────────────────
# Generate with:
#   TRACKING_ENCRYPTION_KEY=$(openssl rand -base64 16)
#   TRACKING_SIGNATURE_KEY=$(openssl rand -base64 32)
TRACKING_ENCRYPTION_KEY=***
TRACKING_SIGNATURE_KEY=***

# ── Email Transport Override ────────────────────────────────────────────────
# Default is automatic hybrid routing (SES shared pool + Hetzner dedicated IPs).
# Set to "smtp" to force all traffic via SMTP relay (legacy/advanced override).
EMAIL_TRANSPORT_TYPE=ses

# ── Grafana ──────────────────────────────────────────────────────────────────
# SECURITY: Change this password! Default is insecure for any non-local deploy.
# Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=***  # Strong password required for non-local Grafana
