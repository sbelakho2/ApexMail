# =============================================================================
# ApexMail Production Environment Configuration
# =============================================================================
# Copy this file to .env and update with your production values
# NEVER commit .env to version control!
#
# SECURITY REQUIREMENTS:
# - All *_SECRET and *_PASSWORD variables MUST be set with strong random values
# - Use: openssl rand -base64 32 to generate secure values
# - Never use default or example values in production
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED SECRETS (Must be set - no defaults)
# -----------------------------------------------------------------------------
# PostgreSQL password - Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# JWT signing secret - Generate with: openssl rand -base64 64
# Minimum 64 characters required
JWT_SECRET=

# API key encryption secret - Generate with: openssl rand -base64 32
# Minimum 32 characters required
API_KEY_HASH_SECRET=

# Redis password (strongly recommended for production)
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string (use SSL in production)
DATABASE_URL=postgresql://user:password@host:5432/apexmail?sslmode=require

# Connection pool settings
DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_URL=redis://:password@host:6379/0
REDIS_KEY_PREFIX=apexmail:

# For Redis Cluster:
# REDIS_CLUSTER_NODES=host1:6379,host2:6379,host3:6379

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Internal service-to-service authentication token.
# ALL internal services (ai-embeddings, pdf-renderer, sales-autopilot,
# template-renderer) require this to be set. Without it, internal auth is
# effectively disabled.
INTERNAL_SERVICE_TOKEN=

# Session settings (SOC2 compliant: 30 minutes max for idle sessions)
SESSION_EXPIRY=1800  # 30 minutes in seconds

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# Login CAPTCHA protection (mCaptcha)
# Applies to both Rust-served `web` and `control-plane` login surfaces
# Server-side verification (required when enabled)
MCAPTCHA_ENABLED=false
MCAPTCHA_SITE_KEY=
MCAPTCHA_SECRET=
MCAPTCHA_VERIFY_URL=https://demo.mcaptcha.org/api/v1/pow/siteverify

# -----------------------------------------------------------------------------
# Email Delivery Transport
# -----------------------------------------------------------------------------
# Transport type: "ses" (default, recommended) or "smtp" (self-hosted opt-in)
EMAIL_TRANSPORT_TYPE=ses

# --- AWS SES (default) ---
# Required when EMAIL_TRANSPORT_TYPE=ses
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
# SES Configuration Set (for deliverability tracking & event publishing)
SES_CONFIGURATION_SET=apexmail-production

# --- Self-Hosted SMTP (opt-in) ---
# Only required when EMAIL_TRANSPORT_TYPE=smtp
# Primary SMTP server
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Connection pooling (SMTP transport only)
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# Per-second rate limit (SMTP transport only; SES rate limit is managed by AWS)
# Typical limits:
# - SendGrid: Varies by plan
# - Postmark: 10/sec
# - Mailgun: 100/sec
SMTP_RATE_LIMIT=10

# -----------------------------------------------------------------------------
# IP Warmup & Rate Limiting (Self-Hosted SMTP only)
# -----------------------------------------------------------------------------
# When using SES, IP warmup is handled automatically by AWS.
# These settings only apply when EMAIL_TRANSPORT_TYPE=smtp.

# Enable IP-based rate limiting for warmup
IP_RATE_LIMITING_ENABLED=true

# Feature flag for IP warmup system
FEATURE_IP_WARMUP=true

# Outbound IP pool (comma-separated list of IPs for round-robin sending)
# Leave empty to use server's primary IP
OUTBOUND_IP_POOL=

# The public IP address this server sends from (for warmup tracking)
# Leave empty to auto-detect or set explicitly
SENDING_IP_ADDRESS=

# Global per-IP hourly limit (burst protection)
# 2500/hour allows ~60K/day theoretical max while preventing bursts
IP_HOURLY_LIMIT=2500

# Per-second burst limit
IP_BURST_LIMIT=50

# Enable domain-based warmup tracking
WARMUP_ENABLED=true

# -----------------------------------------------------------------------------
# Email Tracking
# -----------------------------------------------------------------------------
TRACKING_ENABLED=true

# Secret key used to sign/verify tracking tokens (min 32 chars, generated with:
#   openssl rand -hex 32)
TRACKING_SECRET_KEY=replace-with-at-least-32-random-characters-here

# Public URL for tracking pixel and click redirects
# This should be a fast, globally distributed endpoint
TRACKING_BASE_URL=https://track.yourdomain.com

# Tracking pixel path
TRACKING_OPEN_PATH=/o
TRACKING_CLICK_PATH=/c

# -----------------------------------------------------------------------------
# DKIM Configuration
# -----------------------------------------------------------------------------
DKIM_ENABLED=true
DKIM_SELECTOR=apexmail
# DKIM_KEY_PATH=/path/to/dkim/private/key  # If storing on filesystem

# -----------------------------------------------------------------------------
# Webhook Configuration
# -----------------------------------------------------------------------------
# Maximum webhook retries
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY=30000

# Webhook delivery timeout (ms)
WEBHOOK_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Worker Configuration
# -----------------------------------------------------------------------------
# Unique worker ID (auto-generated if not set)
# WORKER_ID=worker-1

# Queue concurrency
EMAIL_QUEUE_CONCURRENCY=10
WEBHOOK_QUEUE_CONCURRENCY=5
ANALYTICS_QUEUE_CONCURRENCY=2

# Queue polling intervals (ms)
EMAIL_QUEUE_POLL_INTERVAL=1000
WEBHOOK_QUEUE_POLL_INTERVAL=1000
ANALYTICS_QUEUE_POLL_INTERVAL=5000

# Retry settings
EMAIL_QUEUE_MAX_RETRIES=3
EMAIL_QUEUE_RETRY_DELAY=60000

# -----------------------------------------------------------------------------
# Metrics & Monitoring
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9090

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# OpenTelemetry endpoint for distributed tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector:4318

# -----------------------------------------------------------------------------
# Service URLs (for inter-service communication)
# -----------------------------------------------------------------------------
# These are used internally, not exposed to users
API_INTERNAL_URL=http://api:3000
TRACKING_INTERNAL_URL=http://tracking:3001
WORKER_INTERNAL_URL=http://worker:9090

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable billing/subscription features (set to false for CORE_ONLY mode)
BILLING_ENABLED=true

# Enable AI features
AI_ENABLED=false
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx

# Enable sales autopilot
SALES_AUTOPILOT_ENABLED=false

# Enable advanced analytics
ANALYTICS_ENABLED=true

# -----------------------------------------------------------------------------
# Compliance & Security
# -----------------------------------------------------------------------------
# Data retention period (days)
DATA_RETENTION_DAYS=365

# Enable GDPR features
GDPR_ENABLED=true

# Geographic restrictions (comma-separated ISO country codes)
# Leave empty for no restrictions
# GEO_BLOCKED_COUNTRIES=

# -----------------------------------------------------------------------------
# Graceful Shutdown
# -----------------------------------------------------------------------------
# Time to wait for graceful shutdown (ms)
GRACEFUL_SHUTDOWN_TIMEOUT=30000
