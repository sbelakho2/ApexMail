# ApexMail Development Environment Configuration
# =============================================================================
# Copy this file to .env and customise for local development:
#   cp .env.example .env
#
# WARNING: Never commit the actual .env file. It contains local overrides and
# secrets that must stay out of version control.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=apexmail
POSTGRES_PASSWORD=local-dev-password-change-in-production
POSTGRES_DB=apexmail
POSTGRES_PORT=127.0.0.1:5432

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=local-dev-password-change-in-production
REDIS_PORT=127.0.0.1:6379

# ── ClickHouse ──────────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=local-dev-password-change-in-production
CLICKHOUSE_PORT=127.0.0.1:9000
CLICKHOUSE_HTTP_PORT=127.0.0.1:8123

# ── API Server ──────────────────────────────────────────────────────────────
APEXMAIL_API_PORT=8080
APEXMAIL_API_BASE_URL=http://localhost:8080

# ── Email Grader ────────────────────────────────────────────────────────────
GRADER_ENABLED=true
GRADER_RATE_LIMIT=10
GRADER_RATE_WINDOW=3600

# ── Outbound Queue ──────────────────────────────────────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# ── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
