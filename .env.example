# ApexMail Development Environment Configuration
# =============================================================================
# Copy this file to .env and customise for local development:
#   cp .env.example .env
#
# WARNING: Never commit the actual .env file. It contains local overrides and
# secrets that must stay out of version control.
#
# SECRET MANAGEMENT:
#   Values marked with *** are secrets. For production, use Docker secrets
#   (see deploy/load-secret-env.sh) or a dedicated secret manager (Vault, K8s Secrets).
#   In development, replace *** with locally-generated values.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=apexmail
POSTGRES_PASSWORD=***  # Generate: openssl rand -base64 32
POSTGRES_DB=apexmail
# Local port bindings are ALWAYS loopback (127.0.0.1) — set a bare port
# number to change the host port (e.g. 5433); host:port forms are invalid.
POSTGRES_PORT=5432
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apexmail
DB_USER=apexmail
DB_PASSWORD=***  # Same as POSTGRES_PASSWORD for dev convenience
DB_MAX_CONNECTIONS=20
API_REPLICA_COUNT=1
DB_CLUSTER_CONNECTION_BUDGET=

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=***  # Generate: openssl rand -base64 32
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_DB=0
REDIS_POOL_MAX_SIZE=40

# ── ClickHouse ──────────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=***  # Generate: openssl rand -base64 32
CLICKHOUSE_PORT=127.0.0.1:9000
CLICKHOUSE_HTTP_PORT=8123

# ── API Server ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
HOST=0.0.0.0
PORT=3000
BASE_URL=http://localhost:3000
CORS_ORIGINS=*
TRUSTED_PROXIES=
MAX_INFLIGHT_REQUESTS=30
METRICS_PORT=9090
APEXMAIL_API_PORT=3000
APEXMAIL_API_BASE_URL=http://localhost:3000

# JWT keys are required even in development; use escaped newlines if storing in .env.
# SECURITY: These are RSA key pairs for RS256 JWT signing. Never commit real keys.
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n***\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n***\n-----END PUBLIC KEY-----"
JWT_PREVIOUS_PUBLIC_KEYS_PEM=
JWT_EXPIRY=24h
API_KEY_HASH_SECRET=***  # Generate: openssl rand -base64 32
WEBHOOK_SIGNING_SECRET=***  # Generate: openssl rand -base64 32
SESSION_SECRET=***  # Generate: openssl rand -base64 32
IMPERSONATION_SECRET=***  # Generate: openssl rand -base64 32
CSRF_SECRET=***  # Generate: openssl rand -base64 32
TRACKING_SECRET_KEY=***  # Generate: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=***  # Generate: openssl rand -base64 32
CONTROL_PLANE_API_KEY=***  # Generate: openssl rand -base64 32

# UI host routing
UI_WEB_HOSTS=localhost,127.0.0.1,app.apexmail.ee
UI_CONTROL_PLANE_HOSTS=admin.apexmail.ee,control.apexmail.ee
UI_MARKETING_HOSTS=apexmail.ee,www.apexmail.ee
UI_MARKETING_SURFACE=marketing-zola
UI_DEFAULT_SURFACE=web

# API protection
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000
IDEMPOTENCY_TTL_SECONDS=86400

# ── Email Grader ────────────────────────────────────────────────────────────
GRADER_ENABLED=true
GRADER_RATE_LIMIT=10
GRADER_RATE_WINDOW=3600
GRADER_CACHE_TTL=300
GRADER_MAX_BODY_SIZE=1048576

# ── Inbox Placement ─────────────────────────────────────────────────────────
PLACEMENT_ENABLED=true
PLACEMENT_POLLING_INTERVAL=60
PLACEMENT_MAX_POLLING_ATTEMPTS=10
PLACEMENT_MAX_SEEDS_PER_TEST=50
PLACEMENT_MAX_TESTS_PER_HOUR=5
PLACEMENT_IMAP_TIMEOUT=30
PLACEMENT_ENCRYPT_PASSWORDS=true
PLACEMENT_ENCRYPTION_SECRET=***  # Generate: openssl rand -base64 32

# ── Outbound Queue ──────────────────────────────────────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# ── Dedicated IP / SES ──────────────────────────────────────────────────────
AWS_REGION=us-east-1
SES_IP_POOL_PREFIX=apexmail
SES_DEFAULT_WARMUP_DAYS=14
SES_CONFIGURATION_SET=
# Comma-separated allow-list of SNS topic ARNs accepted by the api-server
# POST /v1/ses/notifications handler. WARNING: while unset, EVERY notification
# is rejected with 503 — see deploy/DEPLOYMENT.md § "SES configuration set +
# SNS event destinations" for the one-time AWS setup.
SNS_ALLOWED_TOPIC_ARNS=
# REQUIRED for domain creation and SMTP signing. This must be the same
# 64-character hexadecimal AES-256 key in the API server and worker.
# Generate: openssl rand -hex 32
DKIM_PRIVATE_KEY_ENCRYPTION_KEY=***
# Set to true for one controlled startup to provision the pending platform
# sender. Publish the returned DNS records and verify it before enabling mail.
SYSTEM_SENDER_BOOTSTRAP_ON_STARTUP=false
HETZNER_API_TOKEN=***  # Your Hetzner API token
HETZNER_DEFAULT_LOCATION=fsn1
HETZNER_MTA_SERVER_ID=

# ── OAuth / SSO ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=***  # Your Google OAuth client secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=***  # Your GitHub OAuth client secret
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# ── Billing ────────────────────────────────────────────────────────────────
# Seller payment details on invoices. Bank is Wise; IBAN/BIC/phone are
# rendered ONLY when set (empty = field omitted, never a placeholder).
BILLING_COMPANY_BANK=Wise
BILLING_COMPANY_IBAN=
BILLING_COMPANY_BIC=
BILLING_COMPANY_PHONE=

# ── KiwiCaptcha (native Rust proof-of-work CAPTCHA) ─────────────────────────
# KiwiCaptcha is ApexMail's first-party, memory-hard CAPTCHA. No external
# container or JS — the widget is an inline nonce'd script that solves a
# Proof-of-work CAPTCHA (SHA-256 by default, Argon2id optional — see
# KIWI_ALGORITHM). The web + control-plane auth forms render the widget
# and verify the token on submit.
#
# ON by default. Set to "false" ONLY for local iteration — production must
# keep this true (a startup warning fires while it is disabled).
KIWI_ENABLED=true
# HMAC secret key for signing/verifying challenges. "dev" is accepted
# outside production (debug builds bypass; release builds still verify
# under the dev key) and REFUSED in production.
KIWI_SECRET_KEY=dev
# Argon2id memory cost in KiB (only when KIWI_ALGORITHM=argon2id).
KIWI_ARGON_M_KIB=50000
# Required leading zero bits in the hash output (difficulty).
KIWI_DIFFICULTY_BITS=16
# Challenge lifetime in seconds.
KIWI_CHALLENGE_TTL_SECS=120

# ── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ANALYTICS_IMAGE_SRC=
MARKETING_PUBLIC_DIR=apps/marketing-zola/public

# ── Composite Connection Strings (derived from individual vars above) ───────
# These are convenience aliases. The application also accepts individual
# DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD for the PostgreSQL connection
# and REDIS_HOST/REDIS_PORT for Redis.
# SECURITY: These contain embedded passwords — keep .env out of version control.
DATABASE_URL=postgresql://apexmail:***@localhost:5432/apexmail
REDIS_URL=redis://:***@localhost:6379/0

# ── Storage ─────────────────────────────────────────────────────────────────
# S3-compatible storage endpoint for attachments and exports.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=apexmail-dev
S3_ACCESS_KEY_ID=***  # Your S3 access key
S3_SECRET_ACCESS_KEY=***  # Your S3 secret key

# ── Tracking (Encryption & Signing) ─────────────────────────────────────────
# Generate with:
#   TRACKING_ENCRYPTION_KEY=$(openssl rand -base64 16)
#   TRACKING_SIGNATURE_KEY=$(openssl rand -base64 32)
TRACKING_ENCRYPTION_KEY=***
TRACKING_SIGNATURE_KEY=***
# Worker-side open/click rewrite gate: when true the delivery worker embeds
# the tracking pixel and rewrites links in outbound HTML (requires the shared
# TRACKING_SECRET_KEY above, >= 32 chars, identical to the tracking-service).
TRACKING_ENABLED=true

# ── VERP bounce routing (worker SMTP transport) ─────────────────────────────
# Envelope Return-Path domain for bounces+{message_id}=... addresses. Must
# equal the MTA bounce server's VERP_DOMAIN so bounces land on its parser.
VERP_DOMAIN=bounces.apexmail.ee

# ── Sales Autopilot (internal sales engine, port 3010 internal-only) ────────
# Campaign dispatch config. Without SALES_CAMPAIGN_FROM_EMAIL and
# SALES_UNSUBSCRIBE_SECRET (>= 32 chars) the production dispatcher stays
# unwired and campaign start returns 503 instead of silently not sending.
SALES_CAMPAIGN_FROM_EMAIL=
SALES_CAMPAIGN_FROM_NAME=ApexMail
SALES_UNSUBSCRIBE_SECRET=***  # Generate: openssl rand -base64 32
# Public base used for unsubscribe links. In production this is the nginx
# path prefix on the api vhost: https://api.apexmail.ee/sales-api (only the
# /u/ endpoint beneath it is publicly routed).
SALES_PUBLIC_BASE_URL=http://localhost:3010
SALES_UNSUBSCRIBE_REDIRECT_URL=
# Optional comma-separated tenant allowlist scoping the shared-token service.
SALES_ALLOWED_TENANTS=
SALES_ENRICHMENT_API_URL=https://enrich.apexmail.ee
ENRICHMENT_API_KEY=
SALES_DISPATCH_INTERVAL_SECS=30
SALES_DISPATCH_BATCH_SIZE=100
SALES_DISPATCH_CONCURRENCY=4

# ── Email Transport Override ────────────────────────────────────────────────
# `ses` is the default transport. Set `smtp` only for a deployment whose
# verified domains can be delivered through the configured SMTP relay; SMTP
# still uses each domain's own encrypted DKIM signing key.
EMAIL_TRANSPORT_TYPE=ses

# ── Audit log signing ───────────────────────────────────────────────────────
# HMAC-SHA256 key signing the audit-log hash chain. REQUIRED in production:
# the billing and compliance services leave signatures empty when unset
# (fail-closed, loudly logged). Generate: openssl rand -hex 32
AUDIT_SIGNING_KEY=***

# ── AI service (ai-service) ─────────────────────────────────────────────────
# Deterministic email-assistance helpers are always available; the model
# features are disabled until AI_MODEL_ENABLED=true and an endpoint is set.
AI_MODEL_ENABLED=false
AI_MODEL_ENDPOINT=
AI_MODEL_NAME=
AI_MODEL_API_KEY=
AI_MODEL_TIMEOUT_SECS=30
AI_TRAINING_RUNNER=
AI_TRAINING_WORKING_DIR=
AI_BIND=0.0.0.0:3012
AI_EMAIL_AGENT_ENABLED=false
AI_EMAIL_MAX_TOKENS=1024
AI_EMAIL_POLL_INTERVAL_SECS=15
AI_EMAIL_MAX_BODY_CHARS=8000
AI_EMAIL_REQUIRE_APPROVAL=true

# ── Worker health probe ─────────────────────────────────────────────────────
# Port the worker binary serves /health on (defaults to METRICS_PORT / 9090).
HEALTH_PORT=9090

# ── Grafana ──────────────────────────────────────────────────────────────────
# SECURITY: Change this password! Default is insecure for any non-local deploy.
# Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=***  # Strong password required for non-local Grafana

# Trusted reverse-proxy CIDRs for client-IP extraction (empty = never trust
# forwarded headers). Set when running behind nginx in production.
DDOS_TRUSTED_PROXIES=

# ── Overage (billing-service) ────────────────────────────────────────────────
# Paid plans may send into an overage allowance beyond the included volume
# (100 = +100% of the plan limit); excess is invoiced at EUR 0.40/1,000 at
# period end. 0 = hard stop at the plan limit.
OVERAGE_ALLOWANCE_PERCENT=100
OVERAGE_INVOICING_ENABLED=true
