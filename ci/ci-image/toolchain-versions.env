# =============================================================================
# ci/ci-image/toolchain-versions.env — the apexmail-ci image's version pins.
# =============================================================================
# Machine-readable half of the image's hermeticity contract. Values MUST be
# IDENTICAL to the ARGs at the top of ci/ci-image/Dockerfile — bump them in
# the same change, never separately:
#   * the Dockerfile ARGs install the tools;
#   * this file is COPYed to /etc/apexmail-ci/toolchain-versions.env and is
#     what /usr/local/bin/apexmail-ci-toolchain (--assert) checks the
#     installed versions against, at image build time AND as the first
#     Woodpecker step (.woodpecker.yml).
# A mismatch fails the image build (the Dockerfile ends with
# `apexmail-ci-toolchain --assert`), so a drifted image cannot be pushed.
#
# Audit SM14 F1/F9: both files were missing from the repo entirely — the
# "hermetic" image was unbuildable from source and the pushed :1 tag was
# unverifiable drift.
# =============================================================================

# --- cargo tooling (cargo install --locked, exact versions) -------------------
NEXTEST_VERSION=0.9.143
LLVMCOV_VERSION=0.9.1
DENY_VERSION=0.20.2
MACHETE_VERSION=0.9.2
AUDIT_VERSION=0.22.2
SQLX_VERSION=0.9.0

# --- security / supply-chain binaries -----------------------------------------
GITLEAKS_VERSION=8.30.1
TRIVY_VERSION=0.74.0
SEMGREP_VERSION=1.176.0
HADOLINT_VERSION=2.12.0

# --- python tooling (pip3 install in the image) -------------------------------
PRE_COMMIT_VERSION=4.3.0

# --- languages / site tooling ---------------------------------------------------
COMPOSER_VERSION=2.8.4
ZOLA_VERSION=0.22.1
NODE_MAJOR=22
GO_VERSION=1.23.4

# --- playwright browser pin ------------------------------------------------------
# MUST equal the playwright version resolved by the committed
# tools/contrast-audit/package-lock.json: the executor runs the WORKSPACE
# playwright (npm ci in ci/stages/test.sh) against the browser binaries
# baked into the image at build time (Dockerfile browser layer). A version
# skew makes playwright demand a browser build the image does not carry.
PLAYWRIGHT_VERSION=1.63.0
