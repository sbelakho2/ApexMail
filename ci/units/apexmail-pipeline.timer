[Unit]
Description=Run the ApexMail CI/CD pipeline every 5 minutes (poll mode)
Documentation=file:///opt/apexmail/ci/README.md

[Timer]
# Poll every 5 minutes; the pipeline itself is a no-op (exit 0) when the
# work tree already matches origin/main or a run is in progress.
OnCalendar=*:0/5
# Spread co-tenant load slightly.
RandomizedDelaySec=30
# If the host was down across a tick, run once at boot instead of skipping.
Persistent=true
Unit=apexmail-pipeline.service

[Install]
WantedBy=timers.target
