# =============================================================================
# ApexMail Load Test Infrastructure - Environment Configuration
# =============================================================================
# Copy to .env and customize for your load testing environment:
#   cp .env.example .env
#
# SECURITY: Never commit the .env file. These are load-test-only credentials
# but should still be unique and not reused from production.
# =============================================================================

# PostgreSQL
POSTGRES_USER=apexmail
POSTGRES_PASSWORD=***  # Generate: openssl rand -base64 32
POSTGRES_DB=apexmail_loadtest

# Redis
REDIS_PASSWORD=***  # Generate: openssl rand -base64 32

# k6
K6_API_KEY=***  # Valid API key for the load test target
