[Unit]
Description=ApexMail Auth Server (Rust/Axum API gateway)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/apexmail/auth-server
ExecStart=/opt/apexmail/auth-server/target/release/auth-server
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=append:/opt/apexmail/logs/auth-server.log
StandardError=append:/opt/apexmail/logs/auth-server.log
EnvironmentFile=-/opt/apexmail/.env
Environment=RUST_LOG=info

# Security hardening (permissive; tighten after verifying startup)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/apexmail/logs /opt/apexmail/auth-server/target /var/tmp
ReadOnlyPaths=/opt/apexmail/secrets /etc/resolv.conf /etc/hosts

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
