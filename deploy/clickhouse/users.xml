<clickhouse>
    <!-- =========================================================================
         ApexMail ClickHouse User Configuration (audit I)
         =========================================================================
         Three-user model — the app password and the admin password are
         SEPARATE secrets:

           default         no password, loopback only, NO access_management.
                           Exists only for local `clickhouse-client` on the
                           host/container itself; it can never manage users.
           apexmail        application password (from_env CLICKHOUSE_PASSWORD),
                           readwrite profile, internal networks only,
                           no access_management.
           apexmail_admin  admin password (from_env CLICKHOUSE_ADMIN_PASSWORD),
                           internal networks only (loopback + Docker ranges —
                           there is no dedicated admin network in compose),
                           access_management=1 for schema/user administration.

         Both passwords are injected as env vars by the entrypoint chain
         (deploy/load-secret-env.sh reads the *_FILE Docker secrets first).
         CLICKHOUSE_ADMIN_PASSWORD has a development default in the base
         compose and a required Docker secret in the production overlay.
         ========================================================================= -->

    <users>
        <!-- Local-only, passwordless default user: no remote access, no
             access_management. Safe default for `clickhouse-client` on the
             box itself. -->
        <default>
            <password></password>
            <networks>
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>0</access_management>
        </default>

        <!-- Application user for ApexMail services (tracking, exporters). -->
        <apexmail>
            <!-- Password is loaded from CLICKHOUSE_PASSWORD env var -->
            <password from_env="CLICKHOUSE_PASSWORD"></password>
            <!-- SECURITY: Restricted to internal Docker/container networks only. -->
            <networks>
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
                <ip>172.16.0.0/12</ip>
                <ip>10.0.0.0/8</ip>
                <ip>192.168.0.0/16</ip>
            </networks>
            <profile>readwrite</profile>
            <quota>default</quota>
            <access_management>0</access_management>
        </apexmail>

        <!-- Administrator user: separate password, schema/user management
             allowed. Restrict further (e.g. loopback + a management host)
             when a dedicated admin network exists. -->
        <apexmail_admin>
            <!-- Password is loaded from CLICKHOUSE_ADMIN_PASSWORD env var -->
            <password from_env="CLICKHOUSE_ADMIN_PASSWORD"></password>
            <networks>
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
                <ip>172.16.0.0/12</ip>
                <ip>10.0.0.0/8</ip>
                <ip>192.168.0.0/16</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </apexmail_admin>
    </users>

    <!-- Quotas -->
    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>

    <!-- Profiles -->
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <load_balancing>random</load_balancing>
            <log_queries>0</log_queries>
        </default>
        <readwrite>
            <max_memory_usage>10000000000</max_memory_usage>
            <load_balancing>random</load_balancing>
            <log_queries>1</log_queries>
        </readwrite>
        <!-- The unused `readonly` profile was REMOVED (audit §2 hygiene):
             no user referenced it (default -> default, apexmail ->
             readwrite, apexmail_admin -> default). Re-add and ASSIGN it to
             a user before relying on it — an unassigned profile provides
             no enforcement. -->
    </profiles>
</clickhouse>
