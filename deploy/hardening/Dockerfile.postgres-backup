# postgres-backup with openssl + rsync baked in.
#
# The encryption entrypoint (postgres-backup-encrypt.sh) needs openssl to
# encrypt and rsync for the optional offsite mirror. The stock image lacks
# both, and the container runs on a NO-EGRESS network by policy — the
# script's runtime `apk add` fallback can never reach a CDN, so without this
# image the scheduler silently stores PLAINTEXT database dumps.
FROM prodrigestivill/postgres-backup-local:16-alpine
# Security-tool image: openssl/rsync freshness is the POINT (the container
# runs on a no-egress network and encrypts backups); alpine micro-versions
# churn with the base tag and no digest pin exists for these bases.
# hadolint ignore=DL3018
RUN apk add --no-cache openssl rsync
