{
  "annotations": {"list": []},
  "description": "Real-time monitoring dashboard for ApexMail load testing runs. Provides visibility into request rates, latency distributions, database load, and resource utilization during performance tests.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
