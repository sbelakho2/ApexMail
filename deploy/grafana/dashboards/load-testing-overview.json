        {"expr": "process_resident_memory_bytes{job=~\"apexmail-api|apexmail-tracking\"}", "legendFormat": "Memory - {{job}}", "refId": "B"}
      ],
      "title": "Tracking Service CPU & Memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
