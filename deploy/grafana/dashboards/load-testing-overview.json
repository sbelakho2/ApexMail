          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(apexmail_http_requests_total{job=\"apexmail-api\"}[1m]))",
          "legendFormat": "api req/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(apexmail_http_requests_total{job=\"apexmail-api\",path_pattern=\"/v1/email/send\"}[1m]))",
          "legendFormat": "/v1/email/send",
          "refId": "B"
