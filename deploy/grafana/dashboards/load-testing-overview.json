        {
          "expr": "sum(rate(apexmail_tracking_dedup_total{job=\"apexmail-tracking\"}[1m]))",
          "legendFormat": "tracking deduped/s",
          "refId": "D"
        }
      ],
      "title": "Request Rate",
      "type": "timeseries"
    },
