# =============================================================================
# ApexMail Alertmanager configuration TEMPLATE (audit K)
# =============================================================================
# Alertmanager does NOT expand ${VAR} placeholders — mounting this file raw
# (as older deployments did) shipped literal '${...}' strings into the runtime
# config and silently broke the SMTP/PagerDuty/Slack wiring.
#
# The alertmanager services (docker-compose.yml and
# services/mail-server/docker-compose.yml) render this template at container
# start with a small sh/sed loop (prom/alertmanager is busybox-based and
# ships no envsubst) and write the result to /tmp/alertmanager.yml before
# exec'ing the real binary.
#
# Required variables (the render step fails fast when unset):
#   SMTP_HOST, INTERNAL_SERVICE_TOKEN
# Optional variables (substituted as empty/default when unset):
#   SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, OPSGENIE_API_KEY,
#   PAGERDUTY_ROUTING_KEY, SLACK_WEBHOOK_PATH, SLACK_WEBHOOK_PATH_LOW,
#   ALERT_EMAIL_CRITICAL, ALERT_EMAIL_WARNING
# =============================================================================
global:
  resolve_timeout: 5m
  # Fallback SMTP for email notifications
  smtp_smarthost: '${SMTP_HOST}:${SMTP_PORT}'
  smtp_from: 'alertmanager@apexmail.ee'
  smtp_auth_username: '${SMTP_USERNAME}'
  smtp_auth_password: '${SMTP_PASSWORD}'
  smtp_require_tls: true
  # PagerDuty configuration
  pagerduty_url: 'https://events.pagerduty.com/v2/enqueue'
  # OpsGenie configuration
  opsgenie_api_url: 'https://api.opsgenie.com'
  opsgenie_api_key: '${OPSGENIE_API_KEY}'

route:
  receiver: default
  group_by: ['alertname', 'severity', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h
  routes:
    # ── Critical alerts: PagerDuty/OpsGenie + email + Slack ──
    - matchers:
        - severity="critical"
      receiver: critical
      repeat_interval: 30m
      continue: false
    # ── Warning alerts: Slack + email ──
    - matchers:
        - severity="warning"
      receiver: warning
      repeat_interval: 2h
      continue: false
    # ── Info alerts: Slack (low-priority) ──
    - matchers:
        - severity="info"
      receiver: info
      repeat_interval: 12h
      continue: false

receivers:
  # ── Critical: PagerDuty + OpsGenie + Email + Slack ──
  - name: critical
    pagerduty_configs:
      - routing_key: '${PAGERDUTY_ROUTING_KEY}'
        severity: critical
        send_resolved: true
        images:
          - src: 'https://status.apexmail.ee/assets/img/apexmail-icon.png'
        links:
          - href: 'https://grafana.apexmail.ee/d/apexmail-api'
            text: 'ApexMail API Dashboard'
          - href: 'https://status.apexmail.ee'
            text: 'Status Page'
    opsgenie_configs:
      - api_key: '${OPSGENIE_API_KEY}'
        responders:
          - type: team
            name: 'on-call'
        priority: P1
        send_resolved: true
    webhook_configs:
      - url: 'https://hooks.slack.com/services/${SLACK_WEBHOOK_PATH}'
        send_resolved: true
      - url: 'http://observability:4400/alerts'
        send_resolved: true
        http_config:
          # Bearer auth instead of a custom X-Api-Key header: Alertmanager's
          # http_config has never supported custom headers, and the
          # observability service accepts EITHER x-api-key OR
          # Authorization: Bearer for the same shared token.
          authorization:
            type: Bearer
            credentials: '${INTERNAL_SERVICE_TOKEN}'
    email_configs:
      - to: '${ALERT_EMAIL_CRITICAL}'
        send_resolved: true
        headers:
          subject: '[CRITICAL] {{ .GroupLabels.alertname }} - ApexMail'
          priority: urgent

  # ── Warning: Slack + Email ──
  - name: warning
    webhook_configs:
      - url: 'https://hooks.slack.com/services/${SLACK_WEBHOOK_PATH}'
        send_resolved: true
      - url: 'http://observability:4400/alerts'
        send_resolved: true
        http_config:
          # Bearer auth instead of a custom X-Api-Key header: Alertmanager's
          # http_config has never supported custom headers, and the
          # observability service accepts EITHER x-api-key OR
          # Authorization: Bearer for the same shared token.
          authorization:
            type: Bearer
            credentials: '${INTERNAL_SERVICE_TOKEN}'
    email_configs:
      - to: '${ALERT_EMAIL_WARNING}'
        send_resolved: true
        headers:
          subject: '[WARNING] {{ .GroupLabels.alertname }} - ApexMail'

  # ── Info: Slack (low-priority channel) ──
  - name: info
    webhook_configs:
      - url: 'https://hooks.slack.com/services/${SLACK_WEBHOOK_PATH_LOW}'
        send_resolved: true
      - url: 'http://observability:4400/alerts'
        send_resolved: true
        http_config:
          # Bearer auth instead of a custom X-Api-Key header: Alertmanager's
          # http_config has never supported custom headers, and the
          # observability service accepts EITHER x-api-key OR
          # Authorization: Bearer for the same shared token.
          authorization:
            type: Bearer
            credentials: '${INTERNAL_SERVICE_TOKEN}'

  # ── Default fallback ──
  - name: default
    webhook_configs:
      - url: 'http://observability:4400/alerts'
        send_resolved: true
        http_config:
          # Bearer auth instead of a custom X-Api-Key header: Alertmanager's
          # http_config has never supported custom headers, and the
          # observability service accepts EITHER x-api-key OR
          # Authorization: Bearer for the same shared token.
          authorization:
            type: Bearer
            credentials: '${INTERNAL_SERVICE_TOKEN}'
