# =============================================================================
# ApexMail Tracking Service – Rust multi-stage Dockerfile
# =============================================================================
# Build context must be the repo root:
#   docker build -t apexmail-tracking -f Dockerfile.tracking .
#
# Stage layout
#   deps     – compile *only* workspace dependency crates (cacheable layer)
#   builder  – compile tracking-service with real source
#   runtime  – minimal Debian Slim image, runs as unprivileged user
# =============================================================================

# ── Stage 1: dependency cache ──────────────────────────────────────────────────
FROM rust:1.97.1-slim-bookworm AS deps

# Build-time packages needed by ring / openssl-sys / etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace manifest + lockfile first (invalidated only on dep changes)
COPY services/mail-server/Cargo.toml  services/mail-server/Cargo.lock  ./

COPY services/mail-server/crates ./crates

# The workspace crates reference ../../../../packages/kiwicaptcha (relative to
# services/mail-server/crates/<crate>/). Inside the builder at /build/, that
# resolves to /packages/kiwicaptcha/. Create a symlink so the path resolves.
COPY packages/kiwicaptcha/Cargo.toml /build/packages/kiwicaptcha/Cargo.toml
RUN mkdir -p /build/packages/kiwicaptcha/src && \
    echo "#![allow(dead_code)] pub fn _placeholder() {}" > /build/packages/kiwicaptcha/src/lib.rs && \
    mkdir -p /packages && ln -sf /build/packages/kiwicaptcha /packages/kiwicaptcha

RUN cargo fetch --locked

# ── Stage 2: real build ────────────────────────────────────────────────────────
FROM deps AS builder

# Build the release binary – deps are already compiled, only crate code rebuilds
RUN cargo build --release -p tracking-service

# ── Stage 3: minimal runtime image ────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

# Runtime dependencies: CA certs for TLS outbound, tini for PID-1 hygiene
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    tini \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Unprivileged service account (UID/GID 10001 avoids clash with system users)
RUN groupadd -g 10001 apexmail && \
    useradd  -u 10001 -g apexmail -s /sbin/nologin -M apexmail

COPY --from=builder /build/target/release/tracking-service /usr/local/bin/tracking-service
RUN chmod 0755 /usr/local/bin/tracking-service

USER apexmail
WORKDIR /

LABEL org.opencontainers.image.title="apexmail-tracking" \
    org.opencontainers.image.description="ApexMail tracking service" \
    org.opencontainers.image.source="https://github.com/apexmail" \
    org.opencontainers.image.licenses="PROPRIETARY"

EXPOSE 3001 9092

# Health-check via the /health endpoint exposed by the Axum router
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD ["sh", "-c", "wget -q --spider http://127.0.0.1:3001/health || exit 1"]

# tini as PID-1 handles zombie reaping and forwards SIGTERM to the service
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/tracking-service"]
