# =============================================================================
# ApexMail Status Server (legacy bare-metal unit)
# =============================================================================
# NOTE: the canonical production status page is the `status-server` compose
# service (auth-server image) behind nginx — see deploy/DEPLOYMENT.md. This
# unit remains for the standalone/bare-metal monitoring probe only.
#
# Audit P — the unit previously ran as User=root. It now uses systemd's
# DynamicUser with a locked-down runtime: no root, no new privileges,
# restricted filesystem/system call surface. The monitoring scripts are
# expected under /opt/apexmail/monitoring (world-readable install path);
# adjust WorkingDirectory/ExecStart if you keep them elsewhere.
# =============================================================================
[Unit]
Description=ApexMail Status Server
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/apexmail/monitoring
ExecStart=/usr/bin/python3 /opt/apexmail/monitoring/status_server.py
Restart=always
RestartSec=5
Environment=BASE_URL=https://api.apexmail.ee
Environment=DASHBOARD_URL=https://app.apexmail.ee
Environment=STATUS_URL=https://status.apexmail.ee
Environment=CACHE_TTL=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
