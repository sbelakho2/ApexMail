{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@apexmail/lib/*": ["./packages/lib/src/*"],
      "@apexmail/db/*": ["./packages/db/src/*"],
      "@apexmail/config/*": ["./packages/config/src/*"],
      "@apexmail/types/*": ["./packages/types/src/*"]
    },
    "baseUrl": "."
  },
  "exclude": ["node_modules", "dist", ".next"]
}
